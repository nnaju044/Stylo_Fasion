<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Success - Stylo Fasion</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'playfair': ['Playfair Display', 'serif'],
                        'lato': ['Lato', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <style>
        body { 
            font-family: 'Lato', sans-serif;
        }
        
        /* Success icon animation */
        @keyframes scaleIn {
            0% {
                transform: scale(0);
                opacity: 0;
            }
            50% {
                transform: scale(1.1);
            }
            100% {
                transform: scale(1);
                opacity: 1;
            }
        }
        
        .success-icon {
            animation: scaleIn 0.5s ease-out;
        }
        
        /* Checkmark animation */
        @keyframes drawCheck {
            0% {
                stroke-dashoffset: 100;
            }
            100% {
                stroke-dashoffset: 0;
            }
        }
        
        .checkmark {
            stroke-dasharray: 100;
            animation: drawCheck 0.5s ease-out 0.3s forwards;
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center p-6">

    <!-- Success Card -->
    <div class="bg-white rounded-2xl shadow-lg max-w-2xl w-full p-12">
        
        <!-- Success Icon -->
        <div class="flex justify-center mb-8">
            <div class="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center success-icon">
                <svg class="w-12 h-12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="10" stroke="#10b981" stroke-width="2" fill="none"/>
                    <path class="checkmark" d="M8 12l3 3 5-6" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
            </div>
        </div>
        
        <!-- Success Message -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-4">Order Placed Successfully!</h1>
            <p class="text-gray-600 text-base leading-relaxed">
                Thank you for your purchase. Your order has been confirmed and will be<br>
                shipped soon.
            </p>
        </div>
        
        <!-- Order Details Box -->
        <div class="bg-gray-50 rounded-lg p-6 mb-8">
            <div class="space-y-4">
                <!-- Order Total -->
                <div class="flex justify-between items-center">
                    <span class="text-gray-700 text-base">Order Total:</span>
                    <span class="text-gray-900 font-bold text-lg">₹737.00</span>
                </div>
                
                <!-- Estimated Delivery -->
                <div class="flex justify-between items-center">
                    <span class="text-gray-700 text-base">Estimated Delivery:</span>
                    <span class="text-gray-900 font-bold text-base">3-5 Business Days</span>
                </div>
            </div>
        </div>
        
        <!-- Email Confirmation Message -->
        <div class="text-center mb-8">
            <p class="text-gray-600 text-sm leading-relaxed">
                A confirmation email has been sent to your registered email address with order<br>
                details and tracking information.
            </p>
        </div>
        
        <!-- Continue Shopping Button -->
        <div class="flex justify-center">
            <a href="/" class="bg-[#7c2d12] hover:bg-[#6d2510] text-white font-semibold px-10 py-3 rounded-lg transition-colors inline-block">
                Continue Shopping
            </a>
        </div>
    </div>

    <script>
        // Optional: Add confetti or celebration effect
        console.log('Order placed successfully!');
        
        // Redirect after delay (optional)
        // setTimeout(() => {
        //     window.location.href = '/';
        // }, 5000);
    </script>

</body>
</html>
