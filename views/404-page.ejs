<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <style>
        /* Custom animations */
        @keyframes blink {
            0%, 50%, 100% { opacity: 1; }
            25%, 75% { opacity: 0.3; }
        }
        
        .blink-light {
            animation: blink 2s infinite;
        }
        
        .blink-light:nth-child(2) {
            animation-delay: 1s;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }
        
        .float-animation {
            animation: float 3s ease-in-out infinite;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-gray-300 via-gray-400 to-gray-300 min-h-screen flex items-center justify-center p-6">
    
    <div class="max-w-2xl w-full text-center">
        
        <!-- Title -->
        <h1 class="text-5xl font-bold text-gray-700 mb-12">Oops!</h1>
        
        <!-- Construction Barrier Illustration -->
        <div class="relative inline-block mb-12 float-animation">
            
            <!-- Traffic Cones (Left and Right) -->
            <div class="absolute -left-28 top-16">
                <!-- Left Cone -->
                <svg width="60" height="80" viewBox="0 0 60 80" class="drop-shadow-lg">
                    <!-- Cone base -->
                    <ellipse cx="30" cy="75" rx="25" ry="5" fill="#4a5568"/>
                    <!-- Cone body -->
                    <path d="M 30 10 L 10 70 L 50 70 Z" fill="#dc2626"/>
                    <!-- White stripes -->
                    <path d="M 28 25 L 24 35 L 36 35 L 32 25 Z" fill="white"/>
                    <path d="M 22 45 L 18 55 L 42 55 L 38 45 Z" fill="white"/>
                </svg>
            </div>
            
            <div class="absolute -right-28 top-16">
                <!-- Right Cone -->
                <svg width="60" height="80" viewBox="0 0 60 80" class="drop-shadow-lg">
                    <!-- Cone base -->
                    <ellipse cx="30" cy="75" rx="25" ry="5" fill="#4a5568"/>
                    <!-- Cone body -->
                    <path d="M 30 10 L 10 70 L 50 70 Z" fill="#dc2626"/>
                    <!-- White stripes -->
                    <path d="M 28 25 L 24 35 L 36 35 L 32 25 Z" fill="white"/>
                    <path d="M 22 45 L 18 55 L 42 55 L 38 45 Z" fill="white"/>
                </svg>
            </div>
            
            <!-- Main Barrier -->
            <div class="relative">
                
                <!-- Warning Lights -->
                <div class="flex justify-between absolute -top-8 left-0 right-0 px-4">
                    <!-- Left Light -->
                    <div class="relative blink-light">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-yellow-400 to-orange-500 border-4 border-gray-600 shadow-lg">
                            <div class="absolute inset-2 rounded-full bg-gradient-to-br from-yellow-300 to-orange-400"></div>
                            <div class="absolute inset-3 rounded-full bg-gradient-to-br from-yellow-200 to-orange-300"></div>
                        </div>
                    </div>
                    <!-- Right Light -->
                    <div class="relative blink-light">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-yellow-400 to-orange-500 border-4 border-gray-600 shadow-lg">
                            <div class="absolute inset-2 rounded-full bg-gradient-to-br from-yellow-300 to-orange-400"></div>
                            <div class="absolute inset-3 rounded-full bg-gradient-to-br from-yellow-200 to-orange-300"></div>
                        </div>
                    </div>
                </div>
                
                <!-- Upper Barrier -->
                <div class="relative bg-white border-4 border-gray-600 rounded-lg shadow-xl overflow-hidden" style="height: 80px;">
                    <!-- Diagonal stripes -->
                    <div class="absolute inset-0" style="background: repeating-linear-gradient(
                        45deg,
                        #dc2626,
                        #dc2626 20px,
                        white 20px,
                        white 40px
                    );"></div>
                    
                    <!-- 404 Sign -->
                    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 rotate-0">
                        <div class="relative">
                            <!-- Diamond shape background -->
                            <div class="w-32 h-32 bg-gradient-to-br from-yellow-400 to-yellow-500 transform rotate-45 border-4 border-gray-800 shadow-2xl">
                            </div>
                            <!-- 404 Text -->
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span class="text-4xl font-black text-gray-800">404</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Barrier Legs -->
                <div class="flex justify-around mt-2">
                    <!-- Left Leg -->
                    <div class="w-6 h-16 bg-gradient-to-b from-gray-600 to-gray-700 rounded-b shadow-lg"></div>
                    <!-- Center Left Leg -->
                    <div class="w-6 h-16 bg-gradient-to-b from-gray-600 to-gray-700 rounded-b shadow-lg"></div>
                    <!-- Center Right Leg -->
                    <div class="w-6 h-16 bg-gradient-to-b from-gray-600 to-gray-700 rounded-b shadow-lg"></div>
                    <!-- Right Leg -->
                    <div class="w-6 h-16 bg-gradient-to-b from-gray-600 to-gray-700 rounded-b shadow-lg"></div>
                </div>
                
                <!-- Lower Striped Barrier -->
                <div class="mt-3 bg-white border-4 border-gray-600 rounded-lg shadow-xl overflow-hidden" style="height: 60px;">
                    <!-- Diagonal stripes -->
                    <div class="absolute inset-0" style="background: repeating-linear-gradient(
                        45deg,
                        #dc2626,
                        #dc2626 20px,
                        white 20px,
                        white 40px
                    );"></div>
                </div>
                
                <!-- Lower Barrier Legs -->
                <div class="flex justify-around mt-2">
                    <!-- Left Leg -->
                    <div class="w-6 h-20 bg-gradient-to-b from-gray-600 to-gray-700 rounded-b shadow-lg"></div>
                    <!-- Center Left Leg -->
                    <div class="w-6 h-20 bg-gradient-to-b from-gray-600 to-gray-700 rounded-b shadow-lg"></div>
                    <!-- Center Right Leg -->
                    <div class="w-6 h-20 bg-gradient-to-b from-gray-600 to-gray-700 rounded-b shadow-lg"></div>
                    <!-- Right Leg -->
                    <div class="w-6 h-20 bg-gradient-to-b from-gray-600 to-gray-700 rounded-b shadow-lg"></div>
                </div>
                
                <!-- Ground Shadow -->
                <div class="mt-1 h-4 bg-black bg-opacity-20 rounded-full blur-sm"></div>
            </div>
            <h1 class="text-5xl font-bold text-gray-700 mb-12">404</h1>
        </div>
        
        <!-- Error Message -->
        <div class="mb-8">
            <h2 class="text-4xl font-bold text-gray-700 mb-4">PAGE NOT FOUND</h2>
            <p class="text-gray-600 text-lg mb-2">Sorry, the page you're looking for doesn't exist.</p>
            <p class="text-gray-600 text-base">If you think something is broken, report a problem.</p>
        </div>
        
        <!-- Image Attribution -->
        <p class="text-xs text-gray-500 mb-8 uppercase tracking-wide">Image from <span class="font-semibold">Freepik</span></p>
        
        <!-- Action Buttons -->
        <div class="flex gap-4 justify-center items-center flex-wrap">
            <a href="/" class="px-8 py-3 bg-white hover:bg-gray-100 text-gray-700 font-semibold border-2 border-gray-700 rounded-full shadow-lg transition-all duration-300 transform hover:scale-105">
                GO HOME
            </a>
            <a href="/contact" class="px-8 py-3 bg-white hover:bg-gray-100 text-gray-700 font-semibold border-2 border-gray-700 rounded-full shadow-lg transition-all duration-300 transform hover:scale-105">
                CONTACT US
            </a>
        </div>
    </div>
    
    <script>
        // Optional: Add more interactivity if needed
        console.log('404 Page Loaded');
        
        // Button click handlers
        document.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', function(e) {
                // Add any custom navigation logic here if needed
            });
        });
    </script>
    
</body>
</html>
