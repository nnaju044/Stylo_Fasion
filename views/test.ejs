<style>
    body {
        font-family: 'Lato', sans-serif;
    }

    .playfair {
        font-family: 'Playfair Display', serif;
    }

    .footer-font {
        font-family: 'Georgia', serif;
    }

    /* Color swatch circles */
    .swatch {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 2px solid #e5e7eb;
        display: inline-block;
        cursor: pointer;
    }


    /* Product card hover */
    .product-card:hover .product-overlay {
        opacity: 1;
    }

    .product-overlay {
        transition: opacity 0.2s ease;
    }

    /* Toggle switch */
    .toggle-slider:before {
        content: '';
        position: absolute;
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background: white;
        border-radius: 50%;
        transition: .3s;
    }

    input:checked+.toggle-slider {
        background-color: #7c2d12;
    }

    input:checked+.toggle-slider:before {
        transform: translateX(22px);
    }

    /* Size filter btn */
    .size-btn {
        border: 1px solid #d1d5db;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        cursor: pointer;
        border-radius: 4px;
        transition: all .2s;
    }

    .size-btn:hover,
    .size-btn.active {
        background: #1f2937;
        color: white;
        border-color: #1f2937;
    }

    /* Pagination */
    .page-btn {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e5e7eb;
        border-radius: 4px;
        font-size: 14px;
        cursor: pointer;
        transition: all .2s;
    }

    .page-btn:hover,
    .page-btn.active {
        background: #1f2937;
        color: white;
        border-color: #1f2937;
    }

    /* Product image placeholder */
    .img-placeholder {
        background: linear-gradient(135deg, #f8f8f6 0%, #f0ede8 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="bg-white text-gray-800">

    <!-- ═══════════════════════ PAGE TITLE ═══════════════════════ -->
    <div class="text-center py-8 border-b border-gray-100">
        <h1 class="playfair text-3xl font-bold text-gray-900 tracking-wide">Rings</h1>
    </div>

    <!-- ═══════════════════════ MAIN CONTENT ═══════════════════════ -->
    <div class="max-w-6xl mx-auto px-6 py-8 flex gap-8">

        <!-- ── SIDEBAR FILTERS ── -->
        <aside class="w-44 flex-shrink-0">
            <h2 class="font-bold text-base mb-4 text-gray-900">Filters</h2>

            <!-- Size Filter -->
            <div class="mb-6">
                <p class="text-sm font-semibold text-gray-700 mb-3">Size</p>
                <div class="flex flex-wrap gap-2">
                    <% ['6','7','8','9','10','11','12'].forEach(function(s){ %>
                        <button class="size-btn" data-size="<%= s %>">
                            <%= s %>
                        </button>
                        <% }) %>
                </div>
            </div>

            <!-- Metal Filter -->
            <div class="mb-6">
                <div class="flex items-center gap-6 mb-2">
                    <% metal.forEach(function(s){ %>
                        <span class="swatch" data-metal="<%= s.name %>" style="background:<%= s.color %>;"></span>
                        <% }) %>

                </div>
                <div class="flex gap-3 text-xs text-gray-500 mt-1">
                    <span>Gold</span>
                    <span>Silver</span>
                    <span>Rose-Gold</span>
                </div>
            </div>

            <!-- Price Filter -->
            <div class="mb-4">
                <p class="text-sm font-semibold text-gray-700 mb-2">Prices</p>
                <ul class="space-y-1 text-sm text-gray-500">
                    <li><a href="#" data-min="0" data-max="499" class="hover:text-[#8B1A1A] transition-colors">₹0 –
                            ₹499</a></li>
                    <li><a href="#" data-min="500" data-max="1000" class="hover:text-[#8B1A1A] transition-colors">₹500 –
                            ₹1000</a></li>
                    <li><a href="#" data-min="1000" data-max="9999" class="hover:text-[#8B1A1A] transition-colors">₹1000
                            – ₹9999</a></li>
                    <li><a href="#" data-min="5000" data-max="22999"
                            class="hover:text-[#8B1A1A] transition-colors">₹5000 – ₹22999</a></li>
                    <li><a href="#" data-min="8000" data-max="32999"
                            class="hover:text-[#8B1A1A] transition-colors">₹8000 – ₹32999</a></li>
                </ul>
            </div>
        </aside>

        <!-- ── PRODUCT GRID ── -->
        <div class="flex-1">
            <!-- Sort Bar -->
            <div class="flex items-center justify-between mb-5">
                <p class="text-sm text-gray-500">Best selling <i class="fas fa-chevron-down text-xs ml-1"></i></p>
            </div>

            <div class="grid grid-cols-3 gap-5">
                <% products.forEach(function(product){ %>
                    <div class="product-card group relative cursor-pointer">
                        <!-- Image Box -->
                        <div class="img-placeholder w-full aspect-square rounded-lg overflow-hidden relative mb-3">
                            <!-- Empty space for product image — replace with real <img> tag -->
                            <div class="w-full h-full flex flex-col items-center justify-center text-gray-300">
                                <img src="<%=product.image %>" alt="<%=product.name %>">
                            </div>

                            <!-- Sale Badge -->
                            <% if (product.badge) { %>
                                <span
                                    class="absolute top-2 left-2 bg-[#8B1A1A] text-white text-xs font-bold px-2 py-0.5 rounded">
                                    <%= product.badge %>
                                </span>
                                <% } %>

                                    <!-- Quick-action overlay -->
                                    <div
                                        class="product-overlay absolute inset-0 bg-black bg-opacity-10 opacity-0 flex items-end justify-center pb-4 gap-3">
                                        <button
                                            class="bg-white rounded-full w-9 h-9 flex items-center justify-center shadow hover:bg-gray-100 transition-colors">
                                            <i class="fas fa-heart text-[#8B1A1A] text-sm"></i>
                                        </button>
                                        <button
                                            class="bg-white rounded-full w-9 h-9 flex items-center justify-center shadow hover:bg-gray-100 transition-colors">
                                            <i class="fas fa-shopping-cart text-[#8B1A1A] text-sm"></i>
                                        </button>
                                    </div>
                        </div>

                        <!-- Info -->
                        <h3 class="text-sm font-medium text-gray-800 leading-tight mb-1">
                            <%= product.name %>
                        </h3>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="text-sm font-semibold text-gray-900">
                                <%= product.price %>
                            </span>
                            <% if (product.oldPrice) { %>
                                <span class="text-xs text-gray-400 line-through">
                                    <%= product.oldPrice %>
                                </span>
                                <% } %>
                        </div>


                        
                        <!-- Swatches -->
<div class="flex gap-2 mt-2">
  <% if (product.metals && product.metals.length > 0) { %>

    <% product.metals.forEach(function(metal){ %>
      <span 
        class="swatch <%= metal.toLowerCase().replace(/\s/g, '') %>"
        title="<%= metal %>">
      </span>
    <% }); %>

  <% } %>
</div>




                    </div>
                    <% }) %>
            </div>

            <!-- Pagination -->
            <div class="flex items-center justify-center gap-2 mt-10">
                <button class="page-btn text-gray-400"><i class="fas fa-chevron-left text-xs"></i></button>
                <button class="page-btn active">1</button>
                <button class="page-btn">2</button>
                <button class="page-btn">3</button>
                <span class="text-gray-400 text-sm px-1">...</span>
                <button class="page-btn text-gray-400"><i class="fas fa-chevron-right text-xs"></i></button>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════ BANNER SECTION ═══════════════════════ -->
    <section class="mt-10 grid grid-cols-2 h-72">
        <!-- Left: Image collage with labels -->
        <div class="relative bg-gray-100 overflow-hidden">
            <!-- Left background placeholder image -->
            <div class="w-full h-full img-placeholder flex items-center justify-center">
                <i class="fas fa-images text-6xl text-gray-300"></i>
            </div>
            <!-- Floating labels -->
            <div
                class="absolute top-8 left-6 bg-white text-xs font-semibold px-3 py-1 rounded-full shadow text-gray-700">
                Earrings</div>
            <div
                class="absolute top-24 left-20 bg-white text-xs font-semibold px-3 py-1 rounded-full shadow text-gray-700">
                Bangles</div>
            <div
                class="absolute bottom-12 left-12 bg-white text-xs font-semibold px-3 py-1 rounded-full shadow text-gray-700">
                Rings</div>
        </div>
        <!-- Right: Text -->
        <div class="bg-gray-50 flex flex-col items-center justify-center text-center px-10">
            <p class="playfair text-4xl font-bold text-gray-900 leading-tight">Stylo<br>Fasion</p>
            <p class="playfair text-2xl font-light text-gray-500 mt-1">Into</p>
            <p class="playfair text-5xl font-light italic text-gray-800 leading-none mt-1">Eternity</p>
        </div>
    </section>

    <!-- ═══════════════════════ TRUST BADGES ═══════════════════════ -->
    <section class="border-t border-b border-gray-100 py-8 my-8">
        <div class="max-w-5xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-6">
            <% [ { icon: 'fa-medal' , title: 'High Quality' , sub: 'Crafted from top materials' }, {
                icon: 'fa-shield-halved' , title: 'Warranty Protection' , sub: 'Over 2 years' }, { icon: 'fa-truck' ,
                title: 'Free Shipping' , sub: 'Order over ₹149' }, { icon: 'fa-headset' , title: '24 / 7 Support' ,
                sub: 'Dedicated support' }, ].forEach(function(b){ %>
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0">
                        <i class="fas <%= b.icon %> text-xl text-gray-600"></i>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-800">
                            <%= b.title %>
                        </p>
                        <p class="text-xs text-gray-400 mt-0.5">
                            <%= b.sub %>
                        </p>
                    </div>
                </div>
                <% }) %>
        </div>
    </section>

    <!-- ═══════════════════════ INSTAGRAM SECTION ═══════════════════════ -->
    <section class="max-w-6xl mx-auto px-6 mb-12 text-center">
        <h2 class="playfair text-2xl font-semibold text-gray-900 mb-1">Follow Us On Instagram</h2>
        <p class="text-sm text-gray-500 max-w-md mx-auto mb-6">
            Follow us on Instagram for exclusive jewellery drops, styling inspiration, and member-only offers.
            Stay connected with timeless designs and special surprises.
        </p>
        <!-- Instagram Image Grid -->
        <div class="grid grid-cols-5 gap-2">
            <% for(var i=0; i < 5; i++){ %>
                <div class="aspect-square img-placeholder rounded overflow-hidden flex items-center justify-center">
                    <i class="fab fa-instagram text-4xl text-gray-300"></i>
                </div>
                <% } %>
        </div>
    </section>

    <!-- ═══════════════════════ FOOTER ═══════════════════════ -->
    <footer class="bg-[#3d1010] text-white pt-14 pb-0">
        <div class="max-w-6xl mx-auto px-6 lg:px-12">

            <!-- Top Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-10">

                <!-- Col 1: Brand + QR + App Stores -->
                <div>
                    <h2 class="footer-font text-4xl font-bold mb-5">Stylo Fasion</h2>
                    <p class="text-sm text-gray-300 mb-3">Download the Tanishq App Now</p>
                    <!-- QR Placeholder -->
                    <div class="w-32 h-32 bg-white rounded p-2 mb-4 flex items-center justify-center">
                        <i class="fas fa-qrcode text-5xl text-gray-400"></i>
                    </div>
                    <!-- App Store Buttons -->
                    <div class="flex gap-3">
                        <a href="#"
                            class="flex items-center gap-2 border border-gray-500 rounded px-3 py-2 hover:bg-[#5a1a1a] transition-colors">
                            <i class="fab fa-google-play text-xl"></i>
                            <div>
                                <div class="text-[10px] text-gray-400 leading-none">Download on the</div>
                                <div class="text-xs font-semibold leading-none mt-0.5">Play Store</div>
                            </div>
                        </a>
                        <a href="#"
                            class="flex items-center gap-2 border border-gray-500 rounded px-3 py-2 hover:bg-[#5a1a1a] transition-colors">
                            <i class="fab fa-apple text-xl"></i>
                            <div>
                                <div class="text-[10px] text-gray-400 leading-none">Download on the</div>
                                <div class="text-xs font-semibold leading-none mt-0.5">App Store</div>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- Col 2: Useful Links -->
                <div>
                    <h3 class="text-base font-semibold mb-4">Useful Links</h3>
                    <ul class="space-y-2 text-sm text-gray-300">
                        <% ['Delivery Information','International Shipping','Payment Options','Track your
                            Order','Returns','Find a Store'].forEach(function(link){ %>
                            <li><a href="#" class="hover:text-white transition-colors">
                                    <%= link %>
                                </a></li>
                            <% }) %>
                    </ul>
                </div>

                <!-- Col 3: Information -->
                <div>
                    <h3 class="text-base font-semibold mb-4">Information</h3>
                    <ul class="space-y-2 text-sm text-gray-300">
                        <% ['Blog','Offers & Contest Details','Help & FAQs','About Tanishq'].forEach(function(link){ %>
                            <li><a href="#" class="hover:text-white transition-colors">
                                    <%= link %>
                                </a></li>
                            <% }) %>
                    </ul>
                </div>

                <!-- Col 4: Contact -->
                <div>
                    <h3 class="text-base font-semibold mb-4">Contact Us</h3>
                    <p class="text-gray-300 text-sm mb-4">1800-266-0123</p>
                    <h4 class="font-semibold mb-2">Chat With Us</h4>
                    <p class="text-sm text-gray-300 mb-2">+91 8147349242</p>
                    <div class="border-b border-gray-600 mb-4"></div>
                    <div class="flex gap-4 text-xl">
                        <a href="#" class="hover:text-gray-300 transition-colors"><i class="fab fa-whatsapp"></i></a>
                        <a href="#" class="hover:text-gray-300 transition-colors"><i class="fas fa-envelope"></i></a>
                        <a href="#" class="hover:text-gray-300 transition-colors"><i
                                class="fas fa-comment-dots"></i></a>
                    </div>
                </div>
            </div>

            <!-- Divider -->
            <div class="border-t border-[#6b2222] pt-6 pb-4">
                <!-- Social Row -->
                <div class="flex flex-wrap items-center gap-4 mb-5">
                    <span class="font-semibold text-base">Social</span>
                    <% [['fa-instagram','Instagram'],['fa-x-twitter','X'],['fa-facebook-f','Facebook'],['fa-youtube','YouTube']].forEach(function(s){
                        %>
                        <a href="#"
                            class="w-9 h-9 rounded-full bg-[#5a1a1a] hover:bg-[#7a2222] flex items-center justify-center transition-colors"
                            title="<%= s[1] %>">
                            <i class="fab <%= s[0] %> text-sm"></i>
                        </a>
                        <% }) %>
                </div>

                <!-- Payment Icons -->
                <div class="flex flex-wrap items-center gap-3 mb-6">
                    <div class="bg-white rounded px-2 py-1"><i class="fab fa-cc-visa text-2xl text-blue-700"></i></div>
                    <div class="bg-white rounded px-2 py-1"><i class="fab fa-cc-mastercard text-2xl text-red-600"></i>
                    </div>
                    <div class="bg-white rounded px-2 py-1"><i class="fab fa-cc-mastercard text-2xl text-gray-700"></i>
                    </div>
                    <div class="bg-white rounded px-2 py-1"><span class="text-xs font-bold text-gray-700">PayPal</span>
                    </div>
                    <div class="bg-white rounded px-2 py-1"><span
                            class="text-[10px] font-bold text-gray-700 leading-tight">Diners
                            Club<br>International</span></div>
                    <div class="bg-white rounded px-2 py-1"><i class="fab fa-cc-amex text-2xl text-blue-600"></i></div>
                </div>

                <!-- Bottom Bar -->
                <div
                    class="border-t border-[#6b2222] pt-4 flex flex-wrap items-center justify-between gap-4 text-sm text-gray-400 pb-6">
                    <p>© 2025 Titan Company Limited. All Rights Reserved.</p>
                    <div class="flex gap-5">
                        <a href="#" class="hover:text-white transition-colors">Terms & Conditions</a>
                        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
                        <a href="#" class="hover:text-white transition-colors">Disclaimer</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="/user/product.page.js"></script>

</div>