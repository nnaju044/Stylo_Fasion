<%- include('../partials/head') %>

<body>
  <%- include('../partials/header') %>

  <main>
    <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <% if (alert) { %>
  <script>
    const alertData = <%- JSON.stringify(alert) %>

    if (alertData.mode === 'swal') {
      Swal.fire({
        icon: alertData.type,
        title: alertData.title,
        text: alertData.message,
        confirmButtonColor: "#7f1d1d"
      });
    }

    if (alertData.mode === 'toast') {
      Toastify({
        text: alertData.message,
        duration: 3000,
        gravity: "top",
        position: "right",
        close: true,
        backgroundColor: {
          success: "#16a34a",
          error: "#dc2626",
          warning: "#f59e0b",
          info: "#2563eb"
        }[alertData.type]
      }).showToast();
    }
  </script>
  <% } %>

  <script src="/script/script.js"></script>



  <div id="globalLoader"
     style="
     display:none;
     position:fixed;
     inset:0;
     background:rgba(255,255,255,0.6);
     backdrop-filter: blur(2px);
     z-index:9999;
     justify-content:center;
     align-items:center;
     ">
     
    <div class="loader"></div>
</div>

<style>
.loader{
  width:50px;
  height:50px;
  border:4px solid #f3f3f3;
  border-top:4px solid #7c2d12;
  border-radius:50%;
  animation:spin 1s linear infinite;
}

@keyframes spin{
  0%{transform:rotate(0deg);}
  100%{transform:rotate(360deg);}
}
</style>
</body>
</html>
