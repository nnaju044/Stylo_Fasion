<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rings - Stylo Fasion</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'playfair': ['Playfair Display', 'serif'],
                        'lato': ['Lato', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <style>
        body { 
            font-family: 'Lato', sans-serif; 
        }
        
        /* Color swatches */
        .color-swatch {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 2px solid #e5e7eb;
            cursor: pointer;
            transition: all 0.2s;
        }
        .color-swatch:hover {
            border-color: #9ca3af;
            transform: scale(1.1);
        }
        .color-swatch.gold { background: linear-gradient(135deg, #D4AF37 0%, #F4E0A6 100%); }
        .color-swatch.silver { background: linear-gradient(135deg, #C0C0C0 0%, #E8E8E8 100%); }
        .color-swatch.rosegold { background: linear-gradient(135deg, #E0A898 0%, #F4D4C8 100%); }
        
        /* Size buttons */
        .size-btn {
            min-width: 32px;
            height: 32px;
            padding: 0 8px;
            border: 1px solid #d1d5db;
            border-radius: 4px;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .size-btn:hover, .size-btn.active {
            background: #1f2937;
            color: white;
            border-color: #1f2937;
        }
        
        /* Product card hover */
        .product-card {
            transition: transform 0.2s;
        }
        .product-card:hover {
            transform: translateY(-4px);
        }
        .product-card:hover .quick-actions {
            opacity: 1;
        }
        .quick-actions {
            opacity: 0;
            transition: opacity 0.2s;
        }
        
        /* Pagination buttons */
        .page-btn {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #e5e7eb;
            border-radius: 4px;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .page-btn:hover, .page-btn.active {
            background: #1f2937;
            color: white;
            border-color: #1f2937;
        }
        
        /* Product image placeholder */
        .img-placeholder {
            background: linear-gradient(135deg, #f9f9f7 0%, #f0ede8 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
