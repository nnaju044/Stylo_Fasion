<style>
    /* Sidebar active state */
    .sidebar-item-active {
        background-color: #f1f5f9;
        color: #7c2d12;
    }

    .sidebar-item:hover {
        background-color: #f8fafc;
    }
</style>

<body class="bg-gray-50 font-sans">
    <div class="flex min-h-screen">

        <%- include('../partials/admin/sidebar') %>

            <!-- Main Content -->
            <main class="flex-1 p-8">
                <!-- Header Section -->
                <div class="mb-8 flex justify-between items-start">
                    <div>
                        <h2 class="text-3xl font-bold text-gray-900 mb-2">Metals</h2>
                        <p class="text-gray-600">Manage your product metals</p>
                    </div>
                    <button onclick="openAddMetalModal()"
                        class="bg-red-900 hover:bg-red-800 text-white px-6 py-3 rounded-lg flex items-center gap-2 transition-colors font-medium">
                        <i class="fas fa-plus"></i>
                        <span>Add Metal</span>
                    </button>
                </div>

                <!-- Search Bar -->
                <%- include('../partials/admin/searchBar', { inputId: 'metalSearchInput' ,
                    placeholder: 'Search by Metal Name...' , keyword: typeof search !=='undefined' ? search : '' ,
                    onInputFn: 'handleMetalSearch' , clearBtnId: 'clearMetalSearchBtn' , onClearFn: 'clearMetalSearch'
                    }) %>

                    <!-- Metals Table -->
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
                        <table class="w-full">
                            <thead>
                                <tr class="bg-gray-50 border-b border-gray-200">
                                    <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600">Color</th>
                                    <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600">Metal Name</th>
                                    <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600">Products</th>
                                    <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600">Actions</th>
                                </tr>
                            </thead>
                            <% if (typeof metals !=='undefined' && metals.length> 0) { %>
                                <% metals.forEach(metal=> { %>
                                    <!-- Metal Row -->
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <!-- Color -->
                                        <td class="px-6 py-4">
                                            <div class="w-12 h-12 rounded-lg border border-gray-200"
                                                style="background-color: <%= metal.color %>;"></div>
                                        </td>

                                        <!-- Metal Name -->
                                        <td class="px-6 py-4">
                                            <div class="font-medium text-gray-900">
                                                <%= metal.name %>
                                            </div>
                                        </td>

                                        <!-- Product Count -->
                                        <td class="px-6 py-4">
                                            <div class="text-gray-600">
                                                <%= metal.productCount || 0 %> products
                                            </div>
                                        </td>

                                        <!-- Actions -->
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <button
                                                    onclick="editMetal('<%= metal._id %>', '<%= metal.name %>', '<%= metal.color %>')"
                                                    class="text-red-900 hover:text-red-700 transition-colors"
                                                    title="Edit">
                                                    <i class="fas fa-edit text-lg"></i>
                                                </button>
                                                <button onclick="deleteMetal('<%= metal._id %>')"
                                                    class="text-red-600 hover:text-red-800 transition-colors"
                                                    title="Delete">
                                                    <i class="fas fa-trash text-lg"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="px-6 py-4 text-center text-gray-500">No metals
                                                    found.
                                                </td>
                                            </tr>
                                            <% } %>
                                                </tbody>
                        </table>
                    </div>
            </main>
    </div>

    <!-- Metal Modal -->
    <div id="metal-modal" class="fixed inset-0 z-50 hidden bg-black/50 items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 animate-fade-in-up">
            <h3 id="modal-title" class="text-2xl font-bold text-gray-900 mb-6">Add New Metal</h3>
            <form id="metal-form" onsubmit="submitMetalForm(event)">
                <input type="hidden" id="metal-id" />
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Metal Name</label>
                        <input type="text" id="metal-name" required
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-900 focus:border-red-900 outline-none transition-colors"
                            placeholder="e.g. Gold" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Metal Color (Hex / Color
                            Picker)</label>
                        <div class="flex gap-4 items-center">
                            <input type="color" id="metal-color" required
                                class="w-12 h-12 p-1 border border-gray-300 rounded-lg cursor-pointer"
                                value="#D4AF37" />
                            <input type="text" id="metal-color-text"
                                class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-900 focus:border-red-900 outline-none"
                                placeholder="#D4AF37" />
                        </div>
                    </div>
                </div>
                <div class="mt-8 flex justify-end gap-3">
                    <button type="button" onclick="closeMetalModal()"
                        class="px-5 py-2.5 text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg font-medium transition-colors">Cancel</button>
                    <button type="submit" id="save-metal-btn"
                        class="px-5 py-2.5 text-white bg-red-900 hover:bg-red-800 rounded-lg font-medium transition-colors">Save
                        Metal</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const modal = document.getElementById('metal-modal');
        const colorPicker = document.getElementById('metal-color');
        const colorText = document.getElementById('metal-color-text');

        colorPicker.addEventListener('input', (e) => {
            colorText.value = e.target.value.toUpperCase();
        });

        colorText.addEventListener('input', (e) => {
            let val = e.target.value;
            if (!val.startsWith('#')) {
                val = '#' + val;
            }
            if (/^#[0-9A-Fa-f]{6}$/i.test(val)) {
                colorPicker.value = val;
            }
        });

        function openAddMetalModal() {
            document.getElementById('modal-title').innerText = 'Add New Metal';
            document.getElementById('metal-id').value = '';
            document.getElementById('metal-name').value = '';
            document.getElementById('metal-color').value = '#D4AF37';
            document.getElementById('metal-color-text').value = '#D4AF37';
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        let searchTimeout;
        function handleMetalSearch(value) {
            const clearBtn = document.getElementById('clearMetalSearchBtn');
            if (value.trim().length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
            }

            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                const url = new URL(window.location.href);
                if (value.trim()) {
                    url.searchParams.set('search', value.trim());
                } else {
                    url.searchParams.delete('search');
                }
                window.location.href = url.toString();
            }, 500);
        }

        function clearMetalSearch() {
            document.getElementById('metalSearchInput').value = '';
            handleMetalSearch('');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('metalSearchInput');
            const clearBtn = document.getElementById('clearMetalSearchBtn');
            if (searchInput && searchInput.value.trim().length > 0) {
                clearBtn.classList.remove('hidden');
            }
        });

        function closeMetalModal() {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function editMetal(id, name, color) {
            document.getElementById('modal-title').innerText = 'Edit Metal';
            document.getElementById('metal-id').value = id;
            document.getElementById('metal-name').value = name;
            document.getElementById('metal-color').value = color;
            document.getElementById('metal-color-text').value = color;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        async function submitMetalForm(e) {
            e.preventDefault();
            const id = document.getElementById('metal-id').value;
            const name = document.getElementById('metal-name').value;
            const color = document.getElementById('metal-color').value;

            const btn = document.getElementById('save-metal-btn');
            btn.disabled = true;
            btn.innerText = 'Saving...';

            try {
                let response;
                if (id) {
                    response = await axios.patch(`/admin/metals/${id}`, { name, color });
                } else {
                    response = await axios.post('/admin/metals', { name, color });
                }

                if (response.data.success) {
                    await Swal.fire({ icon: 'success', title: 'Success', text: response.data.message, timer: 1500, showConfirmButton: false });
                    window.location.reload();
                }
            } catch (error) {
                const msg = error.response?.data?.message || 'Something went wrong';
                Swal.fire({ icon: 'error', title: 'Error', text: msg });
            } finally {
                btn.disabled = false;
                btn.innerText = 'Save Metal';
            }
        }

        async function deleteMetal(id) {
            const result = await Swal.fire({
                title: 'Are you sure?',
                text: "You can restore this later simply by creating a metal with the identical name.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#7c2d12',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Yes, delete it!'
            });

            if (result.isConfirmed) {
                try {
                    const response = await axios.patch(`/admin/metals/delete/${id}`);
                    if (response.data.success) {
                        await Swal.fire('Deleted!', 'Metal has been successfully removed.', 'success');
                        window.location.reload();
                    }
                } catch (error) {
                    Swal.fire('Error', error.response?.data?.message || 'Failed to delete metal.', 'error');
                }
            }
        }
    </script>
</body>