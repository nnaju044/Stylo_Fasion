<style>
    /* Image placeholder */
    .img-placeholder {
        background: linear-gradient(135deg, #f9f9f7 0%, #f0ede8 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<body class="bg-gray-50 font-sans">

    <div class="max-w-7xl mx-auto px-6 py-8">

        <!-- Header -->
        <div class="flex items-center justify-between mb-8">
            <!-- Back Button -->
            <a href="/admin/orders" class="flex items-center gap-2 text-gray-700 hover:text-gray-900 transition-colors">
                <i class="fas fa-arrow-left"></i>
                <span class="font-medium">Back to Orders</span>
            </a>

            <% if (order.orderStatus==='CANCELLED' || order.orderStatus==='DELIVERED' || order.orderStatus==='RETURNED'
                ) { %>
                <span
                    class="px-4 py-2 font-bold <%= order.orderStatus === 'DELIVERED' ? 'text-green-700' : 'text-red-700' %> border border-gray-200 rounded-lg bg-white shadow-sm">
                    <%= order.orderStatus %>
                </span>
                <% } else { %>
                    <!-- Status Dropdown -->
                    <select id="statusSelect"
                        class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white cursor-pointer font-bold text-gray-700"
                        data-id="<%= order._id %>">
                        <option value="PENDING" <%=order.orderStatus==='PENDING' ? 'selected' : '' %>>PENDING</option>
                        <option value="PROCESSING" <%=order.orderStatus==='PROCESSING' ? 'selected' : '' %>>PROCESSING
                        </option>
                        <option value="SHIPPED" <%=order.orderStatus==='SHIPPED' ? 'selected' : '' %>>SHIPPED</option>
                        <option value="DELIVERED" <%=order.orderStatus==='DELIVERED' ? 'selected' : '' %>>DELIVERED
                        </option>
                        <option value="CANCELLED" <%=order.orderStatus==='CANCELLED' ? 'selected' : '' %>>CANCELLED
                        </option>
                        <option value="RETURNED" <%=order.orderStatus==='RETURNED' ? 'selected' : '' %>>RETURNED
                        </option>
                    </select>
                    <% } %>
        </div>

        <!-- Order Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">
                Order Details: <span class="text-gray-900">
                    <%=  `#${order._id.toString().slice(-8).toUpperCase()}` %>
                </span>
            </h1>
            <p class="text-gray-600 mb-4">
                <%= new Date(order.createdAt).toLocaleString() %>
            </p>

            <!-- Status Badge -->
            <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-gray-700">Status:</span>
                <span
                    class="<% if (order.orderStatus === 'DELIVERED') { %>bg-green-100 text-green-700<% } else if (order.orderStatus === 'CANCELLED' || order.orderStatus=== 'RETURNED') { %>bg-red-100 text-red-700<% } else { %>bg-blue-100 text-blue-700<% } %> px-3 py-1 rounded-full text-sm font-semibold inline-flex items-center gap-1">
                    <span>
                        <%= order.orderStatus %>
                    </span>
                    <% if (order.orderStatus==='DELIVERED' ) { %>
                        <i class="fas fa-check text-xs"></i>
                        <% } %>
                </span>
            </div>
        </div>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">

            <!-- Shipping Address -->
            <div class="bg-white rounded-lg p-6 border border-gray-200">
                <h2 class="text-xl font-bold text-gray-900 mb-4">Shipping Address</h2>
                <div class="space-y-2 text-gray-700">
                    <p class="font-semibold text-gray-900">
                        <%= order.shippingAddress.fullName || order.user?.fullName %>
                    </p>
                    <p>
                        <%= order.shippingAddress.addressLine || 'N/A' %>
                    </p>
                    <p>
                        <%= order.shippingAddress.city || 'N/A' %>, <%= order.shippingAddress.state || 'N/A' %>
                                <%= order.shippingAddress.pincode || 'N/A' %>
                    </p>
                    <p>
                        <%= order.shippingAddress.country || 'N/A' %>
                    </p>
                    <p class="flex items-start gap-2 mt-4">
                        <span class="font-medium">Email:</span>
                        <a href="mailto:<%= order.user?.email %>" class="text-gray-700 hover:text-gray-900">
                            <%= order.user?.email || 'N/A' %>
                        </a>
                    </p>
                    <p class="flex items-start gap-2">
                        <span class="font-medium">Phone:</span>
                        <span>
                            <%= order.shippingAddress.phone || order.user?.phone || 'N/A' %>
                        </span>
                    </p>
                </div>
            </div>

            <!-- Order Details -->
            <div class="bg-white rounded-lg p-6 border border-gray-200">
                <h2 class="text-xl font-bold text-gray-900 mb-4">Payment & Details</h2>
                <div class="space-y-3">
                    <div class="flex justify-between">
                        <span class="font-semibold text-gray-700">Order ID:</span>
                        <span class="text-gray-900">
                            <%= `#${order._id.toString().slice(-8).toUpperCase()}` %>
                        </span>
                    </div>
                    <div class="flex justify-between">
                        <span class="font-semibold text-gray-700">Payment Status:</span>
                        <span class="text-gray-900">
                            <%= order.paymentStatus || 'PENDING' %>
                        </span>
                    </div>
                    <div class="flex justify-between">
                        <span class="font-semibold text-gray-700">Payment Method:</span>
                        <span class="text-gray-900">
                            <%= order.paymentMethod || 'COD' %>
                        </span>
                    </div>
                    <div class="flex justify-between">
                        <span class="font-semibold text-gray-700">Order Date:</span>
                        <span class="text-gray-900">
                            <%= new Date(order.createdAt).toLocaleDateString() %>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Section -->
        <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
            <div class="p-6 border-b border-gray-200">
                <h2 class="text-xl font-bold text-gray-900">Products Ordered</h2>
            </div>

            <!-- Products Table -->
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600">Product</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600">Image</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600">Size</th>
                            <th
                                class="px-6 py-4 text-left text-sm font-semibold text-gray-600 border-l border-gray-200 pl-4 text-center">
                                Unit Price</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600 text-center">Quantity
                            </th>
                            <th
                                class="px-6 py-4 text-left text-sm font-semibold text-gray-900 border-l border-gray-200 pl-4 text-right">
                                Amount</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <%console.log("order items",order.items) %>
                        <% order.items.forEach(product=> { %>
                            <!-- Product Row -->
                            <tr class="hover:bg-gray-50 align-top">
                                <!-- Product Name & SKU -->
                                <td class="px-6 py-4">
                                    <div class="font-medium text-gray-900">
                                        <%= product.name || 'Unknown' %>
                                    </div>
                                    <div class="text-xs text-gray-500 mt-1">SKU: <%= product.sku || 'N/A' %>
                                    </div>
                                </td>

                                <!-- Image -->
                                <td class="px-6 py-4">
                                    <div
                                        class="w-16 h-16 img-placeholder rounded-lg flex-shrink-0 overflow-hidden border border-gray-200">
                                        <% if (product.image) { %>
                                            <img src="<%= product.image %>" class="w-full h-full object-cover" />
                                            <% } else { %>
                                                <i class="fas fa-image text-2xl text-gray-300"></i>
                                                <% } %>
                                    </div>
                                </td>

                                <!-- Size -->
                                <td class="px-6 py-4">
                                    <span
                                        class="bg-gray-100 text-gray-800 text-xs font-semibold px-2.5 py-0.5 rounded border border-gray-300">
                                        <%= product.size || '-' %>
                                    </span>
                                </td>

                                <!-- Unit Price -->
                                <td class="px-6 py-4 border-l border-gray-200 pl-4 text-center">
                                    <div class="text-gray-900">₹ <%= (product.price || 0).toFixed(2) %>
                                    </div>
                                </td>

                                <!-- Quantity -->
                                <td class="px-6 py-4 text-center">
                                    <div class="text-gray-900 font-medium">x <%= product.quantity || 1 %>
                                    </div>
                                </td>

                                <!-- Amount -->
                                <td class="px-6 py-4 border-l border-gray-200 pl-4 text-right">
                                    <div class="font-bold text-gray-900">₹ <%= ((product.price || 0) * (product.quantity
                                            || 1)).toFixed(2) %>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
            </div>

            <!-- Order Summary -->
            <div class="p-6 border-t border-gray-200 bg-gray-50">
                <div class="max-w-md ml-auto space-y-3">
                    <div class="flex justify-between text-gray-700">
                        <span>Subtotal:</span>
                        <span class="font-semibold">₹ <%= (order.totalAmount || 0).toFixed(2) %></span>
                    </div>
                    <% if (order.shippingAmount> 0) { %>
                        <div class="flex justify-between text-gray-700">
                            <span>Shipping:</span>
                            <span class="font-semibold">₹ <%= order.shippingAmount.toFixed(2) %></span>
                        </div>
                        <% } %>
                            <% if (order.discount> 0) { %>
                                <div class="flex justify-between text-green-600">
                                    <span>Discount (<%= order.discount %>%):</span>
                                    <span class="font-semibold">- ₹ <%= ((order.totalAmount * order.discount) /
                                            100).toFixed(2) %></span>
                                </div>
                                <% } %>
                                    <div
                                        class="flex justify-between text-lg font-bold text-gray-900 pt-3 border-t border-gray-200">
                                        <span>Total:</span>
                                        <span class="text-red-900">₹ <%= (order.finalAmount || order.totalAmount ||
                                                0).toFixed(2) %></span>
                                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts Formatted -->
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Handle status change dynamically
        const selectElem = document.getElementById('statusSelect');
        if (selectElem) {
            selectElem.addEventListener('change', async function () {
                const newStatus = this.value;
                const orderId = this.getAttribute('data-id');
                const prevStatus = "<%= order.orderStatus %>";

                // Confirm status change
                const confirmation = await Swal.fire({
                    title: 'Update Status?',
                    text: `Are you sure you want to change the order status to "${newStatus}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, update it!',
                    confirmButtonColor: '#7c2d12',
                    cancelButtonColor: '#6b7280',
                });

                if (confirmation.isConfirmed) {
                    try {
                        const response = await axios.patch(`/admin/orders/${orderId}/status`, { status: newStatus });
                        if (response.data.success) {
                            await Swal.fire({
                                icon: 'success',
                                title: 'Updated!',
                                text: 'Order status has been updated successfully.',
                                timer: 1500,
                                showConfirmButton: false
                            });
                            window.location.reload();
                        }
                    } catch (error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: error.response?.data?.message || 'Failed to update order status.'
                        });
                        this.value = prevStatus;
                    }
                } else {
                    // Revert dropdown if cancelled
                    this.value = prevStatus;
                }
            });
        }
    </script>

</body>