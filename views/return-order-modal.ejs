<!-- ═══════════════════════════════════════════════════════
     MODAL SCRIPT
════════════════════════════════════════════════════════ -->
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
(function () {
  var modal       = document.getElementById('return-order-modal');
  var closeBtn    = document.getElementById('return-modal-close');
  var cancelBtn   = document.getElementById('return-modal-cancel');
  var submitBtn   = document.getElementById('return-modal-submit');
  var reasonSel   = document.getElementById('return-reason-select');
  var commentBox  = document.getElementById('return-comment');
  var reasonErr   = document.getElementById('reason-error');

  var currentOrderId = '';

  /* ── Public opener ──────────────────────── */
  window.openReturnModal = function (orderId) {
    currentOrderId      = orderId || '';
    reasonSel.value     = '';
    commentBox.value    = '';
    reasonErr.classList.add('hidden');
    reasonSel.classList.remove('border-red-400');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  };

  /* ── Trigger via data attribute ─────────── */
  document.querySelectorAll('.return-order-trigger').forEach(function (btn) {
    btn.addEventListener('click', function () {
      window.openReturnModal(this.dataset.orderId || this.dataset.id || '');
    });
  });

  /* ── Close helpers ──────────────────────── */
  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }
  if (closeBtn)  closeBtn.addEventListener('click',  closeModal);
  if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

  /* ── Validation helper ──────────────────── */
  function validate() {
    if (!reasonSel.value) {
      reasonErr.classList.remove('hidden');
      reasonSel.classList.add('border-red-400');
      reasonSel.focus();
      return false;
    }
    reasonErr.classList.add('hidden');
    reasonSel.classList.remove('border-red-400');
    return true;
  }

  /* ── Submit ─────────────────────────────── */
  if (submitBtn) {
    submitBtn.addEventListener('click', async function () {
      if (!validate()) return;

      var reason  = reasonSel.value;
      var comment = commentBox.value.trim();

      try {
        submitBtn.disabled    = true;
        submitBtn.textContent = 'Processing…';

        var res = await axios.post('/user/orders/' + currentOrderId + '/return', {
          reason:  reason,
          comment: comment,
        });

        closeModal();

        Swal.fire({
          icon:               res.data.success ? 'success' : 'error',
          title:              res.data.success ? 'Return Requested' : 'Request Failed',
          text:               res.data.message || '',
          confirmButtonColor: '#8B1A1A',
        }).then(function () { if (res.data.success) location.reload(); });

      } catch (err) {
        closeModal();
        var msg = err.response && err.response.data && err.response.data.message
                  ? err.response.data.message : 'Something went wrong. Please try again.';
        Swal.fire({ icon: 'error', title: 'Error', text: msg, confirmButtonColor: '#8B1A1A' });
      } finally {
        submitBtn.disabled    = false;
        submitBtn.textContent = 'Request Refund';
      }
    });
  }

})();
</script>
