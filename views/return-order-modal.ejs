<!-- ═══════════════════════════════════════════════════════
     RETURN ORDER MODAL
     Drop this anywhere inside your <body>.
     Trigger open  : call openReturnModal(orderId)
     or add         data-order-id="..." to any button with class "return-order-trigger"
════════════════════════════════════════════════════════ -->

<!-- Backdrop + centred modal -->
<div id="return-order-modal"
     class="fixed inset-0 z-50 hidden items-center justify-center
            bg-gray-600/70 backdrop-blur-[2px]">

  <!-- Modal card — matches screenshot width/padding -->
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-[480px] mx-4 overflow-hidden">

    <!-- ── Header ───────────────────────────────── -->
    <div class="flex items-center justify-between px-7 pt-6 pb-5 border-b border-gray-100">

      <!-- Icon + Title -->
      <div class="flex items-center gap-3">
        <!-- Box icon in a rounded crimson-bordered square -->
        <div class="w-10 h-10 rounded-lg border border-crimson flex items-center justify-center shrink-0">
          <i class="fa-solid fa-cube text-crimson text-base"></i>
        </div>
        <h2 class="text-lg font-bold text-gray-800 tracking-wide">Return Order</h2>
      </div>

      <!-- Close X -->
      <button id="return-modal-close"
              class="text-gray-500 hover:text-crimson transition text-xl leading-none">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- ── Body ─────────────────────────────────── -->
    <div class="px-7 py-7 space-y-6">

      <!-- Reason dropdown -->
      <div class="space-y-2">
        <label class="block text-sm text-center text-crimson font-medium">
          Reason for Return <span class="text-crimson">*</span>
        </label>
        <div class="relative">
          <select id="return-reason-select"
                  class="w-full border border-crimson rounded-lg px-4 py-3 text-sm
                         text-gray-600 bg-white appearance-none text-center
                         focus:outline-none focus:ring-1 focus:ring-crimson cursor-pointer">
            <option value="" disabled selected>Select a reason</option>
            <option value="defective">Defective / Damaged product</option>
            <option value="wrong_item">Wrong item received</option>
            <option value="not_as_described">Not as described</option>
            <option value="size_issue">Size / Fit issue</option>
            <option value="changed_mind">Changed my mind</option>
            <option value="other">Other</option>
          </select>
          <!-- Custom chevron -->
          <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2
                     text-gray-400 text-xs pointer-events-none"></i>
        </div>
        <p id="reason-error" class="hidden text-xs text-red-500 text-center">
          Please select a reason to continue.
        </p>
      </div>

      <!-- Additional comments -->
      <div class="space-y-2">
        <label class="block text-sm text-center text-crimson font-medium">
          Additional Comments (Optional)
        </label>
        <textarea id="return-comment"
                  rows="5"
                  placeholder="Please provide any additional details about your return..."
                  class="w-full border border-crimson rounded-lg px-4 py-3 text-sm
                         text-gray-600 placeholder-gray-400 resize-none bg-white
                         focus:outline-none focus:ring-1 focus:ring-crimson leading-relaxed"></textarea>
      </div>

      <!-- Note box -->
      <div class="bg-gray-100 border border-gray-200 rounded-lg px-5 py-4 text-center">
        <p class="text-sm text-gray-600 leading-relaxed">
          <span class="font-bold text-gray-700">Note: &nbsp;&nbsp;</span>
          Once submitted, you will receive a return confirmation email with further instructions within 24 hours.
        </p>
      </div>

    </div><!-- /body -->

    <!-- ── Footer ───────────────────────────────── -->
    <div class="px-7 pb-7 flex items-center gap-4">

      <!-- Cancel — outlined -->
      <button id="return-modal-cancel"
              class="flex-1 py-3 rounded-lg border border-crimson text-crimson text-sm
                     font-semibold hover:bg-red-50 transition">
        Cancel
      </button>

      <!-- Request Refund — filled -->
      <button id="return-modal-submit"
              class="flex-1 py-3 rounded-lg bg-crimson hover:bg-crimson-dark text-white
                     text-sm font-semibold transition disabled:opacity-60 disabled:cursor-not-allowed">
        Request Refund
      </button>

    </div>

  </div><!-- /modal card -->
</div><!-- /backdrop -->


