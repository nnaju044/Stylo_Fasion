<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout - Stylo Fasion</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            crimson: { DEFAULT: '#8B1A1A', dark: '#6B1414', light: '#a52020' },
            footer:  '#3B0A0A',
          },
          fontFamily: {
            display: ['"Playfair Display"', 'serif'],
            body:    ['Lato', 'sans-serif'],
          },
        },
      },
    }
  </script>

  <style>
    body { font-family: 'Lato', sans-serif; }

    input:focus, select:focus {
      outline: none;
      border-color: #8B1A1A;
      box-shadow: 0 0 0 1px #8B1A1A;
    }
    input[type="checkbox"], input[type="radio"] { accent-color: #8B1A1A; }
    select { appearance: none; }

    .order-scroll::-webkit-scrollbar { width: 4px; }
    .order-scroll::-webkit-scrollbar-track { background: #f1f1f1; }
    .order-scroll::-webkit-scrollbar-thumb { background: #8B1A1A55; border-radius: 2px; }

    /* Payment radio peer trick */
    .payment-option-card input:checked + .pay-card {
      border-color: #8B1A1A;
      background-color: #fff5f5;
    }
    .payment-option-card input:checked + .pay-card .pay-radio-dot {
      border-color: #8B1A1A;
      background-color: #8B1A1A;
    }
    .payment-option-card input:checked + .pay-card .pay-radio-dot::after {
      opacity: 1;
    }
    .payment-option-card input:checked + .pay-card .pay-extra {
      display: flex;
    }

    .pay-radio-dot {
      width: 20px; height: 20px;
      border: 2px solid #d1d5db;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; transition: all .2s;
    }
    .pay-radio-dot::after {
      content: '';
      width: 8px; height: 8px;
      background: white;
      border-radius: 50%;
      opacity: 0;
      transition: opacity .2s;
    }
    .pay-extra { display: none; }

    .wallet-btn { transition: transform .15s, box-shadow .15s; }
    .wallet-btn:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.1); }
    .wallet-btn.active { border-color: #8B1A1A; background: #fff5f5; }
  </style>
</head>
<body class="bg-white text-gray-700">

  <!-- ═══════════════════ NAVBAR ═══════════════════ -->
  <header class="border-b border-gray-200 px-6 md:px-10 py-4 flex items-center justify-between">
    <a href="/" class="font-display text-2xl italic text-crimson font-semibold tracking-wide">Stylo Fasion</a>

    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-600">
      <a href="#" class="hover:text-crimson transition">Home</a>
      <a href="#" class="text-crimson border-b border-crimson pb-0.5">Shop</a>
      <a href="#" class="hover:text-crimson transition">Products</a>
      <div class="flex items-center gap-1 hover:text-crimson transition cursor-pointer">
        Pages <i class="fa-solid fa-chevron-down text-[10px] mt-0.5"></i>
      </div>
    </nav>

    <div class="flex items-center gap-5 text-gray-500 text-lg">
      <a href="#" class="hover:text-crimson transition"><i class="fa-solid fa-magnifying-glass"></i></a>
      <a href="#" class="hover:text-crimson transition"><i class="fa-regular fa-user"></i></a>
      <a href="#" class="hover:text-crimson transition"><i class="fa-regular fa-heart"></i></a>
      <a href="#" class="relative hover:text-crimson transition">
        <i class="fa-solid fa-bag-shopping"></i>
        <span class="absolute -top-2 -right-2 bg-crimson text-white text-[9px] rounded-full w-4 h-4 flex items-center justify-center font-bold">
          <%= (typeof cartData !== 'undefined' && cartData) ? cartData.length : 1 %>
        </span>
      </a>
    </div>
  </header>

  <!-- ═══════════════════ PAGE TITLE ═══════════════════ -->
  <div class="text-center py-7 border-b border-gray-100">
    <h1 class="font-display text-3xl font-semibold text-gray-800 tracking-wide">Checkout</h1>
  </div>

  <!-- ═══════════════════ MAIN GRID ═══════════════════
       Left (col-span-3) = Form   |   Right (col-span-2) = Summary
  ════════════════════════════════════════════════════ -->
  <main class="max-w-6xl mx-auto px-4 py-10 grid grid-cols-1 lg:grid-cols-5 gap-10 items-start">

    <!-- ══════════════════════════════════════
         LEFT — FORM  (cols 1-3)
    ══════════════════════════════════════ -->
    <form id="checkout-form" class="lg:col-span-3 space-y-8 order-2 lg:order-1">

      <!-- ── DELIVERY ── -->
      <section>
        <div class="flex items-center justify-between mb-3">
          <h2 class="font-display text-xl text-crimson font-semibold">Delivery</h2>
          <a href="#" id="change-address-btn" class="text-sm font-semibold text-crimson hover:underline">Change</a>
        </div>

        <div id="selected-address-container">
          <% if (typeof addresses !== 'undefined' && addresses && addresses.length > 0) {
               let defaultAddr = addresses.find(a => a.isDefault) || addresses[0]; %>
            <div class="border border-crimson bg-red-50 rounded p-4">
              <input type="hidden" name="addressId" id="selected-address-id" value="<%= defaultAddr._id %>">
              <div class="text-sm text-gray-600 leading-relaxed">
                <p class="font-bold text-gray-800 mb-0.5" id="selected-address-name">
                  <%= defaultAddr.fullName %> &nbsp;|&nbsp; <%= defaultAddr.phone %>
                </p>
                <p id="selected-address-details">
                  <%= defaultAddr.addressLine %>, <%= defaultAddr.city %>,
                  <%= defaultAddr.state %> – <%= defaultAddr.pincode %>, <%= defaultAddr.country %>
                </p>
              </div>
            </div>
          <% } else { %>
            <div class="p-3 bg-yellow-50 border border-yellow-200 rounded text-sm text-yellow-800">
              No saved address. <a href="/user/addresses" class="font-bold underline">Add one now</a>.
            </div>
          <% } %>
        </div>
      </section>

      <!-- ── PAYMENT METHOD ── -->
      <section>
        <h2 class="font-display text-xl text-crimson font-semibold mb-4">Payment Method</h2>
        <div class="space-y-3">

          <!-- COD -->
          <label class="payment-option-card block cursor-pointer">
            <input type="radio" name="payment" value="cod" class="hidden" checked />
            <div class="pay-card border-2 border-gray-200 rounded-lg p-4 transition-all hover:border-gray-300">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-green-600 rounded-lg flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-hand-holding-dollar text-white text-xl"></i>
                  </div>
                  <div>
                    <p class="font-semibold text-gray-900 text-sm">Cash on Delivery</p>
                    <p class="text-xs text-gray-500">Pay when you receive</p>
                  </div>
                </div>
                <div class="pay-radio-dot"></div>
              </div>
            </div>
          </label>

          <!-- Wallet -->
          <label class="payment-option-card block cursor-pointer">
            <input type="radio" name="payment" value="wallet" class="hidden" />
            <div class="pay-card border-2 border-gray-200 rounded-lg p-4 transition-all hover:border-gray-300">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-wallet text-white text-xl"></i>
                  </div>
                  <div>
                    <p class="font-semibold text-gray-900 text-sm">Stylo Fashion Wallet</p>
                    <p class="text-xs text-gray-500">Use your wallet balance</p>
                  </div>
                </div>
                <div class="pay-radio-dot"></div>
              </div>
              <!-- Wallet sub-options -->
              <div class="pay-extra flex-col mt-4 pt-4 border-t border-gray-200">
                <div class="grid grid-cols-3 gap-3">
                  <button type="button" class="wallet-btn border-2 border-gray-200 rounded-lg p-3 text-center">
                    <img src="https://cdn-icons-png.flaticon.com/512/825/825454.png" alt="Paytm" class="w-8 h-8 mx-auto mb-1" />
                    <span class="text-xs text-gray-600">Paytm</span>
                  </button>
                  <button type="button" class="wallet-btn border-2 border-gray-200 rounded-lg p-3 text-center">
                    <img src="https://cdn-icons-png.flaticon.com/512/5968/5968542.png" alt="PhonePe" class="w-8 h-8 mx-auto mb-1" />
                    <span class="text-xs text-gray-600">PhonePe</span>
                  </button>
                  <button type="button" class="wallet-btn border-2 border-gray-200 rounded-lg p-3 text-center">
                    <img src="https://cdn-icons-png.flaticon.com/512/6124/6124998.png" alt="GPay" class="w-8 h-8 mx-auto mb-1" />
                    <span class="text-xs text-gray-600">GPay</span>
                  </button>
                </div>
              </div>
            </div>
          </label>

          <!-- Razorpay -->
          <label class="payment-option-card block cursor-pointer">
            <input type="radio" name="payment" value="razorpay" class="hidden" />
            <div class="pay-card border-2 border-gray-200 rounded-lg p-4 transition-all hover:border-gray-300">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-credit-card text-white text-xl"></i>
                  </div>
                  <div>
                    <p class="font-semibold text-gray-900 text-sm">Card / UPI / Net Banking</p>
                    <p class="text-xs text-gray-500">Powered by Razorpay</p>
                  </div>
                </div>
                <div class="pay-radio-dot"></div>
              </div>
              <!-- Accepted logos -->
              <div class="pay-extra flex-wrap items-center gap-2 mt-4 pt-4 border-t border-gray-200">
                <span class="text-xs text-gray-500 mr-1">Accepts:</span>
                <i class="fa-brands fa-cc-visa text-blue-700 text-2xl"></i>
                <i class="fa-brands fa-cc-mastercard text-red-600 text-2xl"></i>
                <i class="fa-brands fa-cc-amex text-blue-600 text-2xl"></i>
                <span class="text-xs bg-orange-100 text-orange-700 px-2 py-1 rounded font-semibold">UPI</span>
                <span class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded font-semibold">Net Banking</span>
              </div>
            </div>
          </label>

        </div>

        <!-- Security note -->
        <div class="mt-3 flex items-center gap-2 text-xs text-gray-500">
          <i class="fa-solid fa-shield-halved text-green-600"></i>
          <span>Your payment information is encrypted and secure</span>
        </div>
      </section>

      <!-- ── PLACE ORDER BUTTON ── -->
      <button type="submit" id="pay-button"
        class="w-full bg-crimson hover:bg-crimson-dark text-white font-semibold py-3 rounded
               text-sm tracking-widest uppercase transition disabled:opacity-50 disabled:cursor-not-allowed"
        <%= (typeof addresses !== 'undefined' && addresses && addresses.length > 0 &&
             typeof cartData !== 'undefined' && cartData && cartData.length > 0) ? '' : 'disabled' %>>
        Place Order
      </button>

      <p class="text-center text-[11px] text-gray-400">
        Copyright &copy; 2026 Stylo Fasion. All Rights Reserved.
      </p>
    </form>

    <!-- ══════════════════════════════════════
         RIGHT — ORDER SUMMARY  (cols 4-5)
    ══════════════════════════════════════ -->
    <aside class="lg:col-span-2 bg-gray-50 rounded-lg p-6 space-y-5 order-1 lg:order-2 lg:sticky lg:top-6">

      <!-- Cart items -->
      <div class="space-y-3 max-h-72 overflow-y-auto pr-1 order-scroll">
        <% if (typeof cartData !== 'undefined' && cartData && cartData.length > 0) { %>
          <% cartData.forEach(function(item) { %>
            <div class="flex items-center gap-4 pb-3 border-b border-gray-100 last:border-0">

              <% if (item.productImages && item.productImages.length > 0) { %>
                <img src="<%= item.productImages[0] %>"
                     alt="<%= item.productName %>"
                     class="w-16 h-16 object-cover rounded shadow-sm shrink-0" />
              <% } else { %>
                <div class="w-16 h-16 bg-gray-200 border border-gray-200 rounded shrink-0
                            flex items-center justify-center text-gray-400">
                  <i class="fa-regular fa-image text-2xl"></i>
                </div>
              <% } %>

              <div class="flex-1 min-w-0">
                <p class="font-semibold text-gray-800 text-sm truncate"><%= item.productName %></p>
                <p class="text-xs text-gray-400 mt-0.5">Qty: <%= item.quantity %></p>
              </div>
              <p class="font-semibold text-gray-800 text-sm shrink-0">₹<%= item.total %></p>
            </div>
          <% }) %>
        <% } else { %>
          <!-- Demo row matching screenshot -->
          <div class="flex items-center gap-4 pb-3 border-b border-gray-100">
            <div class="w-16 h-16 bg-gray-200 border border-gray-200 rounded shrink-0
                        flex items-center justify-center text-gray-400">
              <i class="fa-regular fa-image text-2xl"></i>
            </div>
            <div class="flex-1">
              <p class="font-semibold text-gray-800 text-sm">Rosette Radiance</p>
            </div>
            <p class="font-semibold text-gray-800 text-sm">₹697.00</p>
          </div>
        <% } %>
      </div>

      <!-- Coupon link -->
      <p class="text-crimson text-xs font-medium cursor-pointer hover:underline">Available Coupons....</p>

      <!-- Discount code -->
      <div class="flex gap-2">
        <input type="text" placeholder="Discount code"
          class="flex-1 border border-gray-200 rounded px-3 py-2.5 text-sm placeholder-gray-400 bg-white transition" />
        <button type="button"
          class="bg-crimson hover:bg-crimson-dark text-white text-sm px-5 py-2 rounded transition font-semibold">
          Apply
        </button>
      </div>

      <!-- Price breakdown -->
      <div class="space-y-2.5 text-sm border-t border-gray-200 pt-4">
        <div class="flex justify-between text-gray-500">
          <span>Subtotal</span>
          <span class="text-gray-700">₹<%= typeof subtotal !== 'undefined' ? subtotal : '697.00' %></span>
        </div>
        <div class="flex justify-between text-gray-500">
          <span>Shipping</span>
          <span class="text-gray-700">₹<%= typeof shippingAmount !== 'undefined' ? shippingAmount : '40.00' %></span>
        </div>
        <div class="flex justify-between text-gray-500">
          <span>Discount</span>
          <span class="text-gray-700">₹<%= typeof discount !== 'undefined' ? discount : '0.00' %></span>
        </div>
        <div class="flex justify-between font-bold text-gray-800 border-t border-gray-200 pt-3">
          <span>Total</span>
          <span>₹<%= typeof finalAmount !== 'undefined' ? finalAmount : '737.00' %></span>
        </div>
      </div>
    </aside>

  </main>

  <!-- ═══════════════════ ADDRESS MODAL ═══════════════════ -->
  <div id="address-modal"
    class="fixed inset-0 z-50 hidden bg-black/50 items-center justify-center backdrop-blur-sm">
    <div class="bg-white rounded-lg w-full max-w-lg mx-4 flex flex-col max-h-[80vh] shadow-xl">

      <div class="flex justify-between items-center p-4 border-b">
        <h3 class="text-lg font-display font-semibold text-gray-800">Select Delivery Address</h3>
        <button type="button" id="close-modal-btn" class="text-gray-400 hover:text-gray-700 transition">
          <i class="fa-solid fa-xmark text-xl"></i>
        </button>
      </div>

      <div class="p-4 overflow-y-auto flex-1 space-y-3">
        <% if (typeof addresses !== 'undefined' && addresses && addresses.length > 0) {
             let hasDefault = addresses.some(a => a.isDefault); %>
          <% addresses.forEach(function(addr, idx) {
               let isChecked = addr.isDefault || (!hasDefault && idx === 0); %>
            <label
              class="flex gap-3 border rounded p-4 cursor-pointer hover:border-crimson transition modal-address-label
                     <%= isChecked ? 'border-crimson bg-red-50' : 'border-gray-200' %>"
              data-id="<%= addr._id %>"
              data-name="<%= addr.fullName %>"
              data-phone="<%= addr.phone %>"
              data-details="<%= addr.addressLine %>, <%= addr.city %>, <%= addr.state %> – <%= addr.pincode %>, <%= addr.country %>">
              <input type="radio" name="modalAddressId" value="<%= addr._id %>"
                class="mt-1 shrink-0" <%= isChecked ? 'checked' : '' %>>
              <div class="text-sm text-gray-600 leading-relaxed w-full">
                <div class="flex justify-between items-center mb-0.5">
                  <p class="font-bold text-gray-800">
                    <%= addr.fullName %> &nbsp;|&nbsp; <%= addr.phone %>
                  </p>
                  <div class="flex items-center gap-2 shrink-0">
                    <% if (addr.isDefault) { %>
                      <span class="text-[10px] uppercase font-bold tracking-wider bg-crimson text-white px-1.5 py-0.5 rounded">Default</span>
                    <% } %>
                    <a href="/user/addresses"
                      class="text-xs text-blue-600 hover:text-blue-800 hover:underline transition">Edit</a>
                  </div>
                </div>
                <p><%= addr.addressLine %>, <%= addr.city %>, <%= addr.state %> – <%= addr.pincode %>, <%= addr.country %></p>
              </div>
            </label>
          <% }) %>
        <% } else { %>
          <div class="text-center py-6 text-gray-500 text-sm">No addresses found.</div>
        <% } %>
      </div>

      <div class="p-4 border-t flex flex-col gap-3">
        <button type="button" id="confirm-address-btn"
          class="w-full bg-crimson hover:bg-crimson-dark text-white py-2.5 rounded text-sm font-semibold tracking-wide uppercase transition">
          Deliver Here
        </button>
        <a href="/user/addresses"
          class="w-full block text-center border border-gray-300 text-gray-700 py-2.5 rounded text-sm font-semibold uppercase hover:bg-gray-50 transition">
          + Add New Address
        </a>
      </div>
    </div>
  </div>

  <!-- ═══════════════════ FOOTER ═══════════════════ -->
  <footer class="bg-footer text-white mt-10">
    <div class="relative h-10 bg-white overflow-hidden">
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-52 h-10 bg-footer rounded-t-full"></div>
    </div>

    <div class="max-w-6xl mx-auto px-8 pt-12 pb-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <div class="space-y-4">
        <h3 class="font-display text-2xl italic font-semibold">Stylo Fasion</h3>
        <p class="text-sm text-gray-300">Download the Tanishq App Now</p>
        <div class="w-28 h-28 bg-white rounded flex items-center justify-center">
          <i class="fa-solid fa-qrcode text-footer text-5xl"></i>
        </div>
        <div class="flex gap-3 flex-wrap">
          <a href="#" class="flex items-center gap-2 bg-black border border-gray-600 rounded px-3 py-1.5 text-xs hover:bg-gray-800 transition">
            <i class="fa-brands fa-google-play text-green-400 text-base"></i>
            <span><span class="block text-gray-400 text-[9px]">Download on the</span>Play Store</span>
          </a>
          <a href="#" class="flex items-center gap-2 bg-black border border-gray-600 rounded px-3 py-1.5 text-xs hover:bg-gray-800 transition">
            <i class="fa-brands fa-apple text-white text-base"></i>
            <span><span class="block text-gray-400 text-[9px]">Download on the</span>App Store</span>
          </a>
        </div>
      </div>

      <div class="space-y-3">
        <h4 class="text-sm font-bold uppercase tracking-widest text-gray-300">Useful Links</h4>
        <ul class="space-y-2 text-sm text-gray-400">
          <li><a href="#" class="hover:text-white transition">Delivery Information</a></li>
          <li><a href="#" class="hover:text-white transition">International Shipping</a></li>
          <li><a href="#" class="hover:text-white transition">Payment Options</a></li>
          <li><a href="#" class="hover:text-white transition">Track your Order</a></li>
          <li><a href="#" class="hover:text-white transition">Returns</a></li>
          <li><a href="#" class="hover:text-white transition">Find a Store</a></li>
        </ul>
      </div>

      <div class="space-y-3">
        <h4 class="text-sm font-bold uppercase tracking-widest text-gray-300">Information</h4>
        <ul class="space-y-2 text-sm text-gray-400">
          <li><a href="#" class="hover:text-white transition">Blog</a></li>
          <li><a href="#" class="hover:text-white transition">Offers &amp; Contest Details</a></li>
          <li><a href="#" class="hover:text-white transition">Help &amp; FAQs</a></li>
          <li><a href="#" class="hover:text-white transition">About Tanishq</a></li>
        </ul>
      </div>

      <div class="space-y-3">
        <h4 class="text-sm font-bold uppercase tracking-widest text-gray-300">Contact Us</h4>
        <p class="text-sm text-gray-400">1800-266-0123</p>
        <h4 class="text-sm font-bold uppercase tracking-widest text-gray-300 pt-1">Chat With Us</h4>
        <p class="text-sm text-gray-400">+91 8147349242</p>
        <div class="flex gap-4 pt-1 text-xl text-gray-400">
          <a href="#" class="hover:text-green-400 transition"><i class="fa-brands fa-whatsapp"></i></a>
          <a href="#" class="hover:text-white transition"><i class="fa-regular fa-comment-dots"></i></a>
          <a href="#" class="hover:text-white transition"><i class="fa-regular fa-message"></i></a>
        </div>
        <hr class="border-gray-700 mt-2" />
      </div>
    </div>

    <div class="border-t border-gray-700 max-w-6xl mx-auto px-8 py-5 flex flex-col md:flex-row items-center justify-between gap-5">
      <div class="flex items-center gap-4 text-gray-400 text-xl">
        <span class="text-sm font-bold text-white mr-1">Social</span>
        <a href="#" class="hover:text-pink-400 transition"><i class="fa-brands fa-instagram"></i></a>
        <a href="#" class="hover:text-white transition"><i class="fa-brands fa-x-twitter"></i></a>
        <a href="#" class="hover:text-blue-400 transition"><i class="fa-brands fa-facebook-f"></i></a>
        <a href="#" class="hover:text-red-500 transition"><i class="fa-brands fa-youtube"></i></a>
      </div>
      <div class="flex items-center gap-3 text-2xl text-gray-400">
        <i class="fa-brands fa-cc-visa hover:text-blue-400 transition cursor-pointer"></i>
        <i class="fa-brands fa-cc-mastercard hover:text-red-400 transition cursor-pointer"></i>
        <i class="fa-brands fa-cc-amex hover:text-blue-300 transition cursor-pointer"></i>
        <i class="fa-brands fa-cc-discover hover:text-orange-400 transition cursor-pointer"></i>
        <i class="fa-brands fa-cc-diners-club hover:text-gray-200 transition cursor-pointer"></i>
      </div>
    </div>

    <div class="bg-black/30 py-4 text-xs text-gray-500 flex flex-col sm:flex-row items-center justify-center gap-4 px-4">
      <span>&copy; 2025 Titan Company Limited. All Rights Reserved.</span>
      <div class="flex gap-4">
        <a href="#" class="hover:text-white transition">Terms &amp; Conditions</a>
        <a href="#" class="hover:text-white transition">Privacy Policy</a>
        <a href="#" class="hover:text-white transition">Disclaimer</a>
      </div>
    </div>
  </footer>

  <!-- ═══════════════════ SCRIPTS ═══════════════════ -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

  <script>
    /* ── Payment radio selection ─────────────────── */
    document.querySelectorAll('.payment-option-card input[type="radio"]').forEach(function(radio) {
      // trigger on page load for checked one
      if (radio.checked) radio.dispatchEvent(new Event('change'));

      radio.addEventListener('change', function() {
        // reset all cards
        document.querySelectorAll('.payment-option-card .pay-card').forEach(function(card) {
          card.classList.remove('border-crimson', 'bg-red-50');
          card.classList.add('border-gray-200');
          card.querySelector('.pay-radio-dot').style.borderColor = '#d1d5db';
          card.querySelector('.pay-radio-dot').style.backgroundColor = '';
          var dot = card.querySelector('.pay-radio-dot::after');
          var extra = card.querySelector('.pay-extra');
          if (extra) extra.style.display = 'none';
        });

        // activate selected card
        var card = this.nextElementSibling; // .pay-card
        card.classList.add('border-crimson', 'bg-red-50');
        card.classList.remove('border-gray-200');
        var rdot = card.querySelector('.pay-radio-dot');
        rdot.style.borderColor = '#8B1A1A';
        rdot.style.backgroundColor = '#8B1A1A';
        var extra = card.querySelector('.pay-extra');
        if (extra) extra.style.display = 'flex';
      });
    });

    // Init on load
    document.querySelectorAll('.payment-option-card input[type="radio"]').forEach(function(r) {
      if (r.checked) r.dispatchEvent(new Event('change'));
    });

    /* ── Wallet sub-button ───────────────────────── */
    document.querySelectorAll('.wallet-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.wallet-btn').forEach(function(b) { b.classList.remove('active'); });
        this.classList.add('active');
      });
    });

    /* ── Address modal ───────────────────────────── */
    var modal     = document.getElementById('address-modal');
    var changeBtn = document.getElementById('change-address-btn');
    var closeBtn  = document.getElementById('close-modal-btn');
    var confirmBtn = document.getElementById('confirm-address-btn');

    if (changeBtn) changeBtn.addEventListener('click', function(e) {
      e.preventDefault();
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    });
    if (closeBtn) closeBtn.addEventListener('click', function() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    });
    modal.addEventListener('click', function(e) {
      if (e.target === modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });

    if (confirmBtn) confirmBtn.addEventListener('click', function() {
      var selected = document.querySelector('input[name="modalAddressId"]:checked');
      if (!selected) return;

      var label = selected.closest('label');
      var id      = label.dataset.id;
      var name    = label.dataset.name;
      var phone   = label.dataset.phone;
      var details = label.dataset.details;

      document.getElementById('selected-address-id').value = id;
      document.getElementById('selected-address-name').textContent = name + '  |  ' + phone;
      document.getElementById('selected-address-details').textContent = details;

      modal.classList.add('hidden');
      modal.classList.remove('flex');
    });

    /* ── Form submit ─────────────────────────────── */
    document.getElementById('checkout-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      var addressId     = document.getElementById('selected-address-id')
                          ? document.getElementById('selected-address-id').value : null;
      var paymentMethod = document.querySelector('input[name="payment"]:checked')
                          ? document.querySelector('input[name="payment"]:checked').value : 'cod';
      var payBtn        = document.getElementById('pay-button');

      if (!addressId) {
        Swal.fire({ icon: 'warning', title: 'Address missing', text: 'Please select a delivery address!' });
        return;
      }

      try {
        payBtn.disabled    = true;
        payBtn.textContent = 'Processing...';

        var response = await axios.post('/checkout/place-order', {
          addressId:    addressId,
          isCod:        paymentMethod === 'cod',
          paymentMethod: paymentMethod
        });

        if (response.data.success) {
          window.location.href = '/order-success/' + response.data.orderId;
        } else {
          Swal.fire({ icon: 'error', title: 'Oops...', text: response.data.message || 'Something went wrong.' });
          payBtn.disabled    = false;
          payBtn.textContent = 'Place Order';
        }
      } catch (err) {
        var msg = err.response && err.response.data && err.response.data.message
                  ? err.response.data.message : 'Failed to place order.';
        Swal.fire({ icon: 'error', title: 'Order Failed', text: msg });
        payBtn.disabled    = false;
        payBtn.textContent = 'Place Order';
      }
    });
  </script>

</body>
</html>
