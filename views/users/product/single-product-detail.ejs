<!-- PhotoSwipe CSS -->
<link rel="stylesheet"
href="https://unpkg.com/photoswipe@5/dist/photoswipe.css">
<style>
    .material-btn {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 2px solid transparent;
        cursor: pointer;
    }

    .material-btn.active {
        border: 2px solid #7c2d12;
        transform: scale(1.1);
    }

         .quantity-btn {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            cursor: pointer;
            transition: all 0.2s;
        }
        .quantity-btn:hover {
            background: #f3f4f6;
        }
        
        
        
        /* Image placeholder */
        .img-placeholder {
            background: linear-gradient(135deg, #f9f9f7 0%, #f0ede8 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        /* Thumbnail active state */
        .thumbnail {
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.2s;
        }
        .thumbnail:hover, .thumbnail.active {
            border-color: #7c2d12;
        }
        .thumbnail.active{
border:2px solid #7c2d12;
}
.fav-btn.active {
  color: red;
}
</style>

<div class="bg-white text-gray-900">

    <!-- Product Detail Section -->
    <div class="max-w-7xl mx-auto px-6 py-12">
        <div class="grid grid-cols-2 gap-12 items-start">

            <!-- Left: Product Images -->
            <div class="flex gap-4">
                <!-- Thumbnails -->
                <div id="thumbnailContainer" class="flex flex-col gap-3">
                    <% variants[0].images.forEach((img, index)=> { %>
                        <div class="thumbnail w-20 h-20 rounded-lg overflow-hidden cursor-pointer">
                            <img src="<%= img %>" class="w-full h-full object-cover"
                                onclick="changeMainImage('<%= img %>',this)">
                        </div>
                        <% }) %>
                </div>

                <!-- Main Image -->
                <div class="flex-1 img-placeholder rounded-2xl overflow-hidden aspect-square">
                    <img
                      id="mainImage"
                      src="<%= variants[0].images[0] %>"
                      alt="<%= product.name %>"
                      class="w-full h-full object-cover cursor-zoom-in"
                      onclick="zoomImage()"
                    />
                    <div id="gallery" class="hidden">
                        <!-- Gallery links will be created by JavaScript -->
                    </div>
                </div>
            </div>

            <!-- Right: Product Info -->
            <div class="flex flex-col gap-6">
                <!-- Product Title & Wishlist -->
                <div class="flex items-start justify-between mb-3">
                    <h1 class="font-playfair text-3xl font-bold text-gray-900">
                        <%= product.name %>
                    </h1>
                    <button class=" fav-btn text-2xl text-gray-400 hover:text-red-500 transition-colors" data-id="<%=product._id %>">
                        <i class="far fa-heart"></i>
                    </button>
                </div>

                <!-- Rating -->
                <div class="flex items-center gap-1">

<% for(let i=1;i<=5;i++){ %>

  <% if(i <= Math.round(avgRating)){ %>

    <i class="fas fa-star " style="color: #fbbf24;"></i>

  <% }else{ %>

    <i class="far fa-star" style="color: #d1d5db;"></i>

  <% } %>

<% } %>

<span class="text-sm text-gray-500 ml-2">
(<%= reviews.length %> reviews)
</span>

</div>

                <!-- Price -->
                <div class="flex items-center gap-3 mb-6">
                    <span id="productPrice" class="text-3xl font-bold text-gray-900">₹<%= minPrice %>.00</span>
                </div>
                <p><%=product.description%></p>
                <!-- Size Selection -->
                <% const uniqueSizes=[ ...new Set( variants.flatMap(v=> v.sizes.map(s => s.size))
                    )
                    ].sort((a,b)=>a-b);
                    %>

                   <div class="mb-6">
    <label class="text-sm font-semibold text-gray-900 mb-3 block">
        Size
    </label>

    <div class="flex gap-2">
        <% uniqueSizes.forEach(size=> { %>

            <button
                class="sizeBtn border border-gray-300 px-4 py-2 rounded-md text-sm hover:border-red-900 hover:text-red-900 transition"
                data-size="<%= size===1 ? 'Free size':size %>">
                <%= size===1 ? 'Free size':size %>
            </button>

        <% }) %>
    </div>
</div>

                    <!-- Material Selection -->
                    <div class="mb-6">
                        <h3 class="text-sm font-semibold text-gray-900 mb-3 block">
                            Material
                        </h3>

                        <div class="flex gap-3">
                            <% metals.forEach(metal=> { %>

                                <button type="button" class="material-btn" data-metal="<%= metal.name %>"
                                    style="background:<%= metal.color %>" title="<%= metal.name %>">
                                </button>

                                <% }) %>
                        </div>
                    </div>

                     <!-- Quantity -->
                <div class="mb-6">
    <label class="text-sm font-semibold text-gray-900 mb-3 block">Quantity</label>
    <div class="flex items-center w-32 border border-gray-300 rounded-lg overflow-hidden">
        <button class="quantity-btn flex-1 border-r h-10" onclick="decreaseQty()">
            <i class="fas fa-minus text-xs"></i>
        </button>
        <input type="number" id="quantity" value="1" min="1" 
               class="w-12 text-center border-none focus:ring-0 text-sm font-semibold" readonly>
        <button class="quantity-btn flex-1 border-l h-10" onclick="increaseQty()">
            <i class="fas fa-plus text-xs"></i>
        </button>
    </div>
</div>
                
                <!-- Add to Cart Button -->
               <% if (isAvailable) { %>

  <!-- Add to Cart Button -->
  <button 
    style="background-color:#7c2d12 ;"
    class="w-full hover:bg-[#6d2510] text-white font-semibold py-4 rounded-lg transition-colors mb-6">
    Add to cart
  </button>

<% } else { %>

  <!-- Out of Stock -->
  <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                    <div class="flex items-center justify-center gap-2 text-sm text-red-600">
                        <i class="far fa-clock"></i>
                        <span class="font-semibold">Stock Unavailable</span>
                    </div>
                </div>

<% } %>

                    <!-- Additional Info -->
                    <div class="border-t border-gray-200 pt-6 space-y-3">
                       
                        <div class="flex items-center gap-3 text-sm text-gray-600">
                            <i class="fas fa-share-alt text-lg"></i>
                            <span>Share</span>
                        </div>
                    </div>

                    <!-- Delivery Info -->
                    <div class="mt-6 space-y-2 text-sm">
                        <div class="flex items-start gap-2">
                            <i class="fas fa-truck text-gray-500 mt-0.5"></i>
                            <div>
                                <p class="font-semibold text-gray-900">Estimated Delivery: 15 - 25 Aug 01</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-2">
                            <i class="fas fa-shipping-fast text-gray-500 mt-0.5"></i>
                            <div>
                                <p class="font-semibold text-gray-900">Free Shipping & Returns: On all orders over ₹75
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Methods -->
                    <div class="mt-6">
                        <div class="flex flex-wrap items-center gap-2">
                            <i class="fab fa-cc-visa text-3xl text-blue-700"></i>
                            <i class="fab fa-cc-mastercard text-3xl text-red-600"></i>
                            <i class="fab fa-cc-paypal text-3xl text-blue-600"></i>
                            <i class="fab fa-cc-amex text-3xl text-blue-600"></i>
                            <i class="fab fa-cc-discover text-3xl text-orange-500"></i>
                            <i class="fab fa-cc-diners-club text-3xl text-blue-700"></i>
                        </div>
                        <p class="text-xs text-gray-500 mt-2">Guaranteed safe & secure checkout</p>
                    </div>
            </div>
        </div>
    </div>



    <!-- Product Reviews -->
<section class="max-w-5xl mx-auto px-6 py-12">

<h2 class="text-2xl font-bold mb-6">
Customer Reviews
</h2>

<% if(reviews.length === 0){ %>

<p class="text-gray-500">
No reviews yet.
</p>

<% } %>

<div class="space-y-6">

<% reviews.forEach(review => { %>

<div class="border-b pb-4">

<div class="flex items-center gap-3 mb-2">

<img
src="<%= review.userId?.profileImage || 'https://i.pravatar.cc/40' %>"
class="w-8 h-8 rounded-full"
/>

<span class="font-semibold">
<%= review.userId?.firstName %>
</span>

</div>

<!-- rating stars -->

<div class="flex text-yellow-500 mb-2">

<% for(let i=1;i<=5;i++){ %>

<i class="fas fa-star <%= i <= review.rating ? '' : 'text-gray-300' %>"></i>

<% } %>

</div>

<p class="text-gray-700">
<%= review.comment %>
</p>

</div>

<% }) %>

</div>

</section>
  
   

    <!-- People Also Loved Section -->
    <section class="max-w-6xl mx-auto px-6 mb-16">
        <div class="flex items-end justify-between mb-8">
            <div>
                <h2 class="font-playfair text-3xl font-bold text-gray-900 mb-2">People Also Loved</h2>
            </div>
            <button
                class="bg-[#7c2d12] hover:bg-[#6d2510] text-white px-8 py-3 rounded-lg font-semibold transition-colors">
                Buy Now
            </button>
        </div>

        <!-- Product Carousel -->
        <div class="relative">
            <div class="grid grid-cols-4 gap-4">
                    <% relatedProducts.forEach(product=>{ %>

<a href="/user/product/<%= product._id %>">

<div class="group cursor-pointer">

<img src="<%= product.image %>"
class="w-full aspect-square object-cover rounded-lg">

<h3 class="text-sm mt-2">
<%= product.name %>
</h3>

<p class="font-semibold">
₹<%= product.price %>
</p>

</div>

</a>

<% }) %>
            </div>

             <!-- Trust Badges -->
    <section class="border-t border-b border-gray-100 py-10 mb-12">
        <div class="max-w-6xl mx-auto px-6">
            <div class="grid grid-cols-4 gap-8">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-medal text-2xl text-gray-600"></i>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-900">High Quality</p>
                        <p class="text-xs text-gray-500">Crafted from top materials</p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-shield-alt text-2xl text-gray-600"></i>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-900">Warranty Protection</p>
                        <p class="text-xs text-gray-500">Over 2 years</p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-shipping-fast text-2xl text-gray-600"></i>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-900">Free Shipping</p>
                        <p class="text-xs text-gray-500">Order over ₹149</p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-headset text-2xl text-gray-600"></i>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-900">24 / 7 Support</p>
                        <p class="text-xs text-gray-500">Dedicated support</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

            <!-- Carousel Dots -->
            <div class="flex items-center justify-center gap-2 mt-6">
                <button class="w-2 h-2 rounded-full bg-gray-300"></button>
                <button class="w-2 h-2 rounded-full bg-gray-900"></button>
                <button class="w-2 h-2 rounded-full bg-gray-300"></button>
                <button class="w-2 h-2 rounded-full bg-gray-300"></button>
                <button class="w-2 h-2 rounded-full bg-gray-300"></button>
            </div>
        </div>
    </section>


    <script>
        window.variants = <%- JSON.stringify(variants) %>
            console.log("window.variants:", window.variants)

    </script>
    <!-- PhotoSwipe JS -->
<script type="module">
import PhotoSwipeLightbox from
'https://unpkg.com/photoswipe@5/dist/photoswipe-lightbox.esm.js';

window.PhotoSwipeLightbox = PhotoSwipeLightbox;
</script>
    <script src="https://cdn.jsdelivr.net/npm/js-image-zoom/js-image-zoom.min.js"></script>   
    <script src="/script/user/single-product.page.js"></script>
    <script src="/script/searchBar.header.js"></script>

</div>

