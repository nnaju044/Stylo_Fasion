<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Success - Stylo Fasion</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <!-- Google Fonts -->
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Lato:wght@300;400;700&display=swap"
        rel="stylesheet" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        crimson: { DEFAULT: '#8B1A1A', dark: '#6B1414', light: '#a52020' },
                        footer: '#3B0A0A',
                    },
                    fontFamily: {
                        display: ['"Playfair Display"', 'serif'],
                        body: ['Lato', 'sans-serif'],
                    },
                },
            },
        }
    </script>
    <style>
        body {
            font-family: 'Lato', sans-serif;
        }
    </style>
</head>

<body class="bg-gray-50 text-gray-700 font-body min-h-screen flex flex-col">

    <!-- NAVBAR -->
    <header class="bg-white border-b border-gray-200 px-8 py-4 flex items-center justify-between shadow-sm shrink-0">
        <a href="/" class="font-display text-2xl italic text-crimson font-semibold tracking-wide">
            Stylo Fasion
        </a>
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-600">
            <a href="/" class="hover:text-crimson transition">Home</a>
            <a href="/shop" class="hover:text-crimson transition">Shop</a>
            <a href="/products" class="hover:text-crimson transition">Products</a>
        </nav>
        <div class="flex items-center gap-5 text-gray-500 text-lg">
            <a href="/profile" class="hover:text-crimson transition"><i class="fa-regular fa-user"></i></a>
            <a href="/cart" class="hover:text-crimson transition"><i class="fa-solid fa-bag-shopping"></i></a>
        </div>
    </header>

    <!-- SUCCESS CONTENT -->
    <main class="flex-1 flex items-center justify-center p-6">
        <div
            class="bg-white p-10 mt-10 rounded-2xl shadow-lg max-w-lg w-full text-center border border-gray-100 relative overflow-hidden">
            <!-- Decorative background glow -->
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-red-50 rounded-full blur-3xl opacity-60"></div>

            <!-- Illustration / Icon -->
            <div
                class="w-24 h-24 bg-green-50 text-green-500 rounded-full flex items-center justify-center mx-auto mb-6 shadow-indigo-50 shadow-sm relative z-10">
                <i class="fa-solid fa-check text-5xl"></i>
            </div>

            <h1 class="font-display text-3xl font-bold text-gray-800 mb-2 relative z-10">Thank You!</h1>
            <p class="text-gray-500 text-sm mb-8 relative z-10 leading-relaxed">
                Your order <strong>#<%= order ? order._id.toString().slice(-6).toUpperCase() : '1A2B3C' %></strong> has
                been placed successfully. We'll send you an email confirmation shortly!
            </p>

            <!-- Order Brief -->
            <% if (typeof order !=='undefined' && order) { %>
                <div
                    class="bg-gray-50 rounded-lg p-4 mb-8 text-left border border-gray-100 flex items-center justify-between text-sm relative z-10 shrink-0">
                    <div class="text-gray-500 space-y-1">
                        <p>Order Total:</p>
                        <p>Payment Method:</p>
                    </div>
                    <div class="text-gray-800 font-semibold text-right space-y-1">
                        <p>₹<%= order.finalAmount %>
                        </p>
                        <p>
                            <%= order.paymentMethod %>
                        </p>
                    </div>
                </div>
                <% } %>

                    <!-- Action Buttons -->
                    <div class="flex flex-col sm:flex-row gap-4 relative z-10">
                        <a href="<%= typeof order !== 'undefined' && order ? '/order/' + order._id : '/profile/orders' %>"
                            class="flex-1 bg-white border border-gray-200 text-gray-700 py-3 rounded-lg font-semibold hover:bg-gray-50 hover:text-crimson transition-colors duration-200 text-sm">
                            View Order Details
                        </a>
                        <a href="/"
                            class="flex-1 bg-crimson hover:bg-crimson-dark text-white py-3 rounded-lg font-semibold transition-colors duration-200 shadow-md shadow-crimson/20 tracking-wide text-sm">
                            Continue Shopping
                        </a>
                    </div>

        </div>
    </main>

    <!-- FOOTER -->
    <footer class="bg-white py-4 text-center text-xs text-gray-400 border-t mt-auto">
        <span>© 2026 Stylo Fashion. All Rights Reserved.</span>
    </footer>

</body>

</html>