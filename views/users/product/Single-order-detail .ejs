<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          crimson: { DEFAULT: '#8B1A1A', dark: '#6B1414', light: '#a52020' },
          footer: '#3B0A0A',
        },
        fontFamily: {
          display: ['"Playfair Display"', 'serif'],
          body: ['Lato', 'sans-serif'],
        },
      },
    },
  }
</script>

<style>
  body {
    font-family: 'Lato', sans-serif;
    background-color: #f3f4f6;
  }

  /* ── Stepper connector lines ── */
  .step-line {
    flex: 1;
    height: 2px;
    margin-top: -24px;
    /* align with icon centre */
  }

  .step-line.done {
    background-color: #22c55e;
  }

  .step-line.pending {
    background-color: #d1d5db;
  }
</style>

<body class="bg-gray-100 text-gray-700">


  <!-- ═══════════════════ MAIN WRAPPER ═══════════════════ -->
  <div class="max-w-5xl mx-auto px-4 md:px-6 py-10 space-y-6">

 
    <div class="bg-white rounded-2xl shadow-sm px-8 pt-7 pb-8">

      <!-- Order ID row -->
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-2">
        <div>
          <h2 class="text-xl font-bold text-crimson tracking-wide">
            Order ID: <%= order.orderId || `#${order._id.toString().slice(-8).toUpperCase()}` %>
          </h2>
          <button id="download-invoice-btn" class="text-xs text-crimson font-semibold hover:underline mt-0.5 inline-flex items-center gap-1">
            <i class="fa-solid fa-download"></i> Download Invoice
          </button>
        </div>
        <div class="text-right text-sm space-y-1">
          <p>
            <span class="text-gray-500">Order date: &nbsp;</span>
            <span class="text-crimson font-semibold">
              <%= new Date(order.createdAt).toLocaleDateString('en-US',{ month:'short', day:'numeric', year:'numeric' })
                %>
            </span>
          </p>
          <p>
            <span class="text-gray-500">Last Updated: &nbsp;</span>
            <span class="text-crimson font-semibold">
              <%= new Date(order.updatedAt).toLocaleDateString('en-US',{ month:'long', day:'numeric', year:'numeric' })
                %>
            </span>
          </p>
        </div>
      </div>

      <!-- ── ORDER STEPPER ── -->
      <% var currentStatus=(order.orderStatus || 'PENDING' ).toLowerCase(); var stepIndex=0; if
        (currentStatus==='pending' ) stepIndex=0; else if (currentStatus==='processing' ) stepIndex=1; else if
        (currentStatus==='shipped' ) stepIndex=2; else if (currentStatus==='out for delivery' ||
        currentStatus==='out_for_delivery' ) stepIndex=3; else if (currentStatus==='delivered' ) stepIndex=4; else if
        (currentStatus==='cancelled' || currentStatus==='returned' ) stepIndex=-1; var steps=[ { label: 'Pending' ,
        icon: 'fa-circle-check' }, { label: 'Processing' , icon: 'fa-circle-check' }, { label: 'Shipped' ,
        icon: 'fa-circle-check' }, { label: 'Out for Delivery' , icon: 'fa-circle-check' }, { label: 'Delivered' ,
        icon: 'fa-circle-check' }, ]; %>

        <% if (stepIndex===-1) { %>
          <div
            class="mt-8 flex items-center justify-center w-full px-4 py-3 bg-red-50 text-red-600 rounded drop-shadow-sm border border-red-200">
            <i class="fa-solid fa-circle-xmark text-xl mr-2"></i>
            <span class="font-bold text-lg">Order <%= currentStatus==='returned' ? 'Returned' : 'Cancelled' %></span>
          </div>
          <% } else { %>
            <div class="mt-8 flex items-start justify-between w-full">
              <% steps.forEach(function(step, i) { var done=(i <=stepIndex); var iconCol=done ? 'text-green-500'
                : 'text-gray-300' ; var textCol=done ? 'text-green-600' : 'text-gray-400' ; var lineCol=(i < stepIndex)
                ? 'done' : 'pending' ; %>
                <!-- Step node -->
                <div class="flex flex-col items-center text-center w-28 shrink-0">
                  <i class="fa-solid <%= step.icon %> text-4xl <%= iconCol %>"></i>
                  <p class="text-xs font-semibold mt-2 <%= textCol %>">
                    <%= step.label %>
                  </p>
                </div>

                <!-- Connector line -->
                <% if (i < steps.length - 1) { %>
                  <div class="step-line <%= lineCol %> self-start mt-5 mx-1"></div>
                  <% } %>
                    <% }) %>
            </div>
            <% } %>
    </div>

  
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 items-start">

      <!-- ── LEFT: Order Details ────────── -->
      <div class="lg:col-span-3 bg-white rounded-2xl shadow-sm px-8 py-7 space-y-6">

        <h3 class="text-base font-bold text-crimson">Order Details</h3>

        <!-- Items -->
        <% order.items.forEach(function(item) { var img=item.image; var name=item.name || 'Product' ; var
          qty=item.quantity || 1; var price=item.total || (item.price * item.quantity); %>
          <div class="flex items-center gap-5 pb-5 border-b border-gray-100 last:border-0 last:pb-0">
            <% if (img) { %>
              <img src="<%= img %>" alt="<%= name %>"
                class="w-20 h-20 object-cover rounded-xl border border-gray-100 shrink-0" />
              <% } else { %>
                <div class="w-20 h-20 rounded-xl border border-gray-200 bg-gray-50
                          flex items-center justify-center text-gray-300 shrink-0">
                  <i class="fa-regular fa-image text-3xl"></i>
                </div>
                <% } %>
                  <div class="flex-1 min-w-0">
                    <p class="font-semibold text-gray-800 text-sm">
                      <%= name %>
                    </p>
                    <p class="text-xs text-gray-500 mt-1">Size: <%= item.size || '-' %>
                    </p>
                    <p class="text-xs text-gray-500 mt-0.5 mb-2">Qty: <%= qty %>
                    </p>
                    <div class="flex items-center gap-3">
                      <% 
                        let status = item.itemStatus || 'PENDING';
                        // Handle legacy state where itemStatus is PENDING but global order progressed
                        if (status === 'PENDING' && ['SHIPPED', 'DELIVERED', 'CANCELLED', 'RETURNED'].includes(order.orderStatus)) {
                           status = order.orderStatus;
                        }
                      %>
                      <% if (['PENDING','PROCESSING'].includes(status) && ['PENDING','PROCESSING'].includes(order.orderStatus)) { %>
                        <button class="cancel-item-btn bg-red-800 hover:bg-red-900 text-white text-xs font-semibold px-4 py-2 rounded-lg transition shadow-sm"
                           data-order-id="<%= order._id %>" data-item-id="<%= item._id %>" style="background-color: #8B1A1A;">Cancel Item</button>
                      <% } else if (status === 'DELIVERED') { %>
                        <button class="return-item-btn bg-red-800 hover:bg-red-900 text-white text-xs font-semibold px-4 py-2 rounded-lg transition shadow-sm"
                           data-order-id="<%= order._id %>" data-item-id="<%= item._id %>" style="background-color: #8B1A1A;">Return Item</button>
                        <button class="feedback-item-btn bg-white hover:bg-red-50 text-red-800 border border-red-800 text-xs font-semibold px-4 py-2 rounded-lg transition shadow-sm"
                           style="color: #8B1A1A; border-color: #8B1A1A;">Feedback</button>
                      <% } else if (status === 'RETURN_REQUESTED') { %>
                        <span class="bg-yellow-100 text-yellow-800 border border-yellow-200 text-xs font-semibold px-3 py-1.5 rounded-lg">Return Processing...</span>
                      <% } else if (status === 'RETURNED') { %>
                        <span class="bg-green-100 text-green-800 border border-green-200 text-xs font-semibold px-3 py-1.5 rounded-lg">Returned</span>
                      <% } else if (status === 'CANCELLED') { %>
                        <span class="bg-red-100 text-red-800 border border-red-200 text-xs font-semibold px-3 py-1.5 rounded-lg">Cancelled</span>
                      <% } else if (status === 'SHIPPED') { %>
                        <span class="text-xs text-blue-600 font-semibold italic">Item Shipped</span>
                      <% } %>
                    </div>
                  </div>
                  <p class="font-semibold text-gray-800 text-sm shrink-0">₹<%= price %>
                  </p>
          </div>
          <% }) %>

            <hr class="border-gray-100" />

            <!-- Payment -->
            <div>
              <h4 class="text-sm font-bold text-crimson mb-2">Payment Mechanism</h4>
              <p class="text-sm text-gray-600">
                By <%= order.paymentMethod %> (<%= order.paymentStatus %>)
              </p>
            </div>

            <hr class="border-gray-100" />

            <!-- Delivery -->
            <div>
              <h4 class="text-sm font-bold text-crimson mb-3">Delivery Address</h4>
              <% var addr=order.shippingAddress; %>
                <p class="text-sm text-gray-500 mb-1">
                  <%= addr.fullName %>
                </p>
                <p class="text-sm text-crimson font-medium">
                  <%= addr.addressLine %>
                </p>
                <p class="text-sm text-crimson font-medium">
                  <%= addr.city %>, <%= addr.state %>
                      <%= addr.pincode %>
                </p>
                <p class="text-sm text-crimson font-medium">
                  <%= addr.country %>
                </p>
                <p class="text-sm text-crimson font-medium mt-0.5">
                  <%= addr.phone %>
                </p>
            </div>

            <!-- Item-level action buttons handle cancellation now -->


      </div>

      <!-- ── RIGHT: Order Summary ────────── -->
      <aside class="lg:col-span-2 bg-white rounded-2xl shadow-sm px-7 py-7 space-y-4 lg:sticky lg:top-6">
        <h3 class="text-base font-bold text-crimson mb-2">Order Summary</h3>

        <!-- Breakdown -->
        <div class="space-y-3 text-sm">
          <div class="flex justify-between text-gray-600">
            <span>Subtotal</span>
            <span>₹<%= order.totalAmount %></span>
          </div>
          <% if(order.discount> 0) { %>
            <div class="flex justify-between text-green-600">
              <span>Discount</span>
              <span>-₹<%= ((order.totalAmount * order.discount) / 100).toFixed(2) %></span>
            </div>
            <% } %>
              <div class="flex justify-between text-gray-600">
                <span>Shipping</span>
                <span>+₹<%= order.shippingAmount %></span>
              </div>
        </div>

        <hr class="border-gray-100" />

        <!-- Total -->
        <div class="flex justify-between items-center font-bold text-gray-800">
          <span>Total</span>
          <span class="text-crimson text-base">
            ₹<%= order.finalAmount %>
          </span>
        </div>
      </aside>

    </div>

    <!-- Delivered actions have been moved to item-level inside the Order Details card -->
  </div>


  <!-- Backdrop -->
  <div id="cancel-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-gray-400/60 backdrop-blur-[2px]">

    <!-- Modal box -->
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl mx-4 overflow-hidden">

      <!-- ── Header ── -->
      <div class="flex items-center justify-between px-8 pt-7 pb-5">
        <h2 class="font-display text-2xl font-bold text-crimson tracking-wide">Cancel Order</h2>
        <button id="modal-close" class="text-crimson font-bold text-xl hover:opacity-70 transition leading-none">
          X
        </button>
      </div>

      <!-- ── Body ── -->
      <div class="bg-gray-100 px-8 py-6">
        <p class="text-sm font-semibold text-crimson mb-3">Reason for cancellation</p>
        <div class="bg-white rounded-xl px-4 py-1">
          <textarea id="cancel-reason" rows="2" placeholder="Type the reason for cancellation" class="w-full resize-none bg-transparent text-sm text-gray-500
                         placeholder-gray-400 py-3 focus:outline-none"></textarea>
        </div>
      </div>

      <!-- ── Footer ── -->
      <div class="border-t border-gray-100 px-8 py-5 flex items-center justify-end gap-4">

        <!-- Cancel button -->
        <button id="modal-cancel" class="px-7 py-2.5 rounded-xl border-2 border-red-800 text-red-800
                     text-sm font-bold hover:bg-red-50 transition" style="border-color: #8B1A1A; color: #8B1A1A;">
          Cancel
        </button>

        <!-- Submit button -->
        <button id="modal-submit" class="px-7 py-2.5 rounded-xl bg-red-800 hover:bg-red-900 text-white
                     text-sm font-bold transition" style="background-color: #8B1A1A;">
          Submit
        </button>

      </div>
    </div>
  </div>


  <!-- Backdrop + centred modal -->
  <div id="return-order-modal" class="fixed inset-0 z-50 hidden items-center justify-center"
    style="background-color: rgba(75, 85, 99, 0.7); backdrop-filter: blur(2px);">

    <!-- Modal card -->
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4 p-4 md:p-6 overflow-hidden"
      style="max-width: 480px;">

      <!-- ── Header ───────────────────────────────── -->
      <div class="flex items-center justify-between px-7 pt-6 pb-5 border-b border-gray-100">

        <!-- Icon + Title -->
        <div class="flex items-center gap-3">
          <!-- Box icon in a rounded crimson-bordered square -->
          <div class="w-10 h-10 rounded-lg border border-red-800 flex items-center justify-center shrink-0"
            style="border-color: #8B1A1A;">
            <i class="fa-solid fa-cube text-red-800 text-base" style="color: #8B1A1A;"></i>
          </div>
          <h2 class="text-lg font-bold text-gray-800 tracking-wide">Return Order</h2>
        </div>

        <!-- Close X -->
        <button id="return-modal-close" class="text-gray-500 hover:text-red-800 transition text-xl leading-none">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- ── Body ─────────────────────────────────── -->
      <div class="px-7 py-7 space-y-6">

        <!-- Reason dropdown -->
        <div class="space-y-2">
          <label class="block text-sm text-center text-red-800 font-medium" style="color: #8B1A1A;">
            Reason for Return <span class="text-red-800" style="color: #8B1A1A;">*</span>
          </label>
          <div class="relative">
            <select id="return-reason-select" class="w-full border rounded-lg px-4 py-3 text-sm
                         text-gray-600 bg-white appearance-none text-center
                         focus:outline-none focus:ring-1 cursor-pointer"
              style="border-color: #8B1A1A; outline-color: #8B1A1A;">
              <option value="" disabled selected>Select a reason</option>
              <option value="defective">Defective / Damaged product</option>
              <option value="wrong_item">Wrong item received</option>
              <option value="not_as_described">Not as described</option>
              <option value="size_issue">Size / Fit issue</option>
              <option value="changed_mind">Changed my mind</option>
              <option value="other">Other</option>
            </select>
            <!-- Custom chevron -->
            <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2
                     text-gray-400 text-xs pointer-events-none"></i>
          </div>
          <p id="reason-error" class="hidden text-xs text-red-500 text-center">
            Please select a reason to continue.
          </p>
        </div>

        <!-- Additional comments -->
        <div class="space-y-2">
          <label class="block text-sm text-center text-red-800 font-medium" style="color: #8B1A1A;">
            Additional Comments (Optional)
          </label>
          <textarea id="return-comment" rows="5"
            placeholder="Please provide any additional details about your return..." class="w-full border rounded-lg px-4 py-3 text-sm
                         text-gray-600 placeholder-gray-400 resize-none bg-white
                         focus:outline-none focus:ring-1 leading-relaxed"
            style="border-color: #8B1A1A; outline-color: #8B1A1A;"></textarea>
        </div>

        <!-- Note box -->
        <div class="bg-gray-100 border border-gray-200 rounded-lg px-5 py-4 text-center">
          <p class="text-sm text-gray-600 leading-relaxed">
            <span class="font-bold text-gray-700">Note: &nbsp;&nbsp;</span>
            Once submitted, you will receive a return amount in your wallet within 24 hours.
          </p>
        </div>

      </div><!-- /body -->

      <!-- ── Footer ───────────────────────────────── -->
      <div class="px-7 pb-7 flex items-center gap-4">

        <!-- Cancel — outlined -->
        <button id="return-modal-cancel" class="flex-1 py-3 rounded-lg border text-sm
                     font-semibold hover:bg-red-50 transition" style="border-color: #8B1A1A; color: #8B1A1A;">
          Cancel
        </button>

        <!-- Request Refund — filled -->
        <button id="return-modal-submit" class="flex-1 py-3 rounded-lg bg-red-800 hover:bg-red-900 text-white
                     text-sm font-semibold transition" style="background-color: #8B1A1A;">
          Request Refund
        </button>

      </div>

    </div>
  </div>







  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>
  <script>
    window.orderData = <%- JSON.stringify(order) %>;
  </script>
  <script src="/script/user/single-order-details.js"></script>
</body>