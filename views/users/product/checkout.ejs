

  <style>
    body { font-family: 'Lato', sans-serif; }

    /* Thin input focus ring in crimson */
    input:focus, select:focus {
      outline: none;
      border-color: #8B1A1A;
      box-shadow: 0 0 0 1px #8B1A1A;
    }

    /* Custom checkbox accent */
    input[type="checkbox"] { accent-color: #8B1A1A; }

    /* Dropdown arrow colour */
    select { background-image: none; }
  </style>
<body class="bg-white text-gray-700 font-body">

  <!-- =========================================================
       PAGE TITLE
  ========================================================= -->
  <div class="text-center py-8 border-b border-gray-100">
    <h1 class="font-display text-3xl font-semibold text-gray-800 tracking-wide">Checkout</h1>
  </div>

  <!-- =========================================================
       MAIN CONTENT
  ========================================================= -->
  <main class="max-w-6xl mx-auto px-4 py-10 grid grid-cols-1 lg:grid-cols-5 gap-10">

    <!-- ── LEFT: Form ─────────────────────────────────────── -->
    <div class="lg:col-span-3 space-y-8">

      <!-- Default address bar -->
      <div class="border border-gray-200 rounded px-4 py-3 flex items-center justify-between text-sm text-gray-500">
        <span>123, Gold Plaza, MG Road, Near City Mall, Kochi – 682001, Kerala, India</span>
        <button class="text-xs bg-crimson text-white px-3 py-1 rounded hover:bg-crimson-dark transition">
          Use Default
        </button>
      </div>

      <!-- ── CONTACT ── -->
      <section>
        <h2 class="font-display text-xl text-crimson font-semibold mb-3">Contact</h2>
        <input
          type="email"
          placeholder="Email Address"
          class="w-full border border-gray-200 rounded px-4 py-2.5 text-sm placeholder-gray-400 transition"
        />
      </section>

      <!-- ── DELIVERY ── -->
      <section>
        <h2 class="font-display text-xl text-crimson font-semibold mb-3">Delivery</h2>
        <div class="space-y-3">

          <!-- Country dropdown -->
          <div class="relative">
            <select class="w-full border border-gray-200 rounded px-4 py-2.5 text-sm text-gray-400 appearance-none bg-white">
              <option value="" disabled selected>Country / Region</option>
              <option>India</option>
              <option>United States</option>
              <option>United Kingdom</option>
              <option>UAE</option>
            </select>
            <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none"></i>
          </div>

          <!-- Name row -->
          <div class="grid grid-cols-2 gap-3">
            <input type="text" placeholder="First Name"
              class="border border-gray-200 rounded px-4 py-2.5 text-sm placeholder-gray-400 transition" />
            <input type="text" placeholder="Last Name"
              class="border border-gray-200 rounded px-4 py-2.5 text-sm placeholder-gray-400 transition" />
          </div>

          <!-- Address -->
          <input type="text" placeholder="Address"
            class="w-full border border-gray-200 rounded px-4 py-2.5 text-sm placeholder-gray-400 transition" />

          <!-- Phone -->
          <input type="tel" placeholder="Phone"
            class="w-full border border-gray-200 rounded px-4 py-2.5 text-sm placeholder-gray-400 transition" />

          <!-- City / Postal -->
          <div class="grid grid-cols-2 gap-3">
            <input type="text" placeholder="City"
              class="border border-gray-200 rounded px-4 py-2.5 text-sm placeholder-gray-400 transition" />
            <input type="text" placeholder="Postal Code"
              class="border border-gray-200 rounded px-4 py-2.5 text-sm placeholder-gray-400 transition" />
          </div>

          <!-- Save checkbox -->
          <label class="flex items-center gap-2 text-sm text-gray-500 cursor-pointer select-none">
            <input type="checkbox" class="w-4 h-4 rounded" />
            Save This Info For Future
          </label>
        </div>
      </section>

      <!-- ── PAYMENT ── -->
      <section>
        <h2 class="font-display text-xl text-crimson font-semibold mb-3">Payment</h2>
        <div class="space-y-3">

          <!-- Card type selector -->
          <div class="relative">
            <select class="w-full border border-gray-200 rounded px-4 py-2.5 text-sm text-gray-600 appearance-none bg-white">
              <option>Credit Card</option>
              <option>Debit Card</option>
              <option>Net Banking</option>
              <option>UPI</option>
            </select>
            <!-- Card icons -->
            <div class="absolute right-8 top-1/2 -translate-y-1/2 flex gap-1">
              <i class="fa-brands fa-cc-visa text-blue-700 text-lg"></i>
              <i class="fa-brands fa-cc-mastercard text-red-600 text-lg"></i>
            </div>
            <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none"></i>
          </div>

          <!-- Card number -->
          <div class="relative">
            <input type="text" placeholder="Card Number"
              class="w-full border border-gray-200 rounded px-4 py-2.5 text-sm placeholder-gray-400 transition pr-10" />
            <i class="fa-solid fa-lock absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
          </div>

          <!-- Expiry / CVV -->
          <div class="grid grid-cols-2 gap-3">
            <input type="text" placeholder="Expiration Date"
              class="border border-gray-200 rounded px-4 py-2.5 text-sm placeholder-gray-400 transition" />
            <input type="text" placeholder="Security Code"
              class="border border-gray-200 rounded px-4 py-2.5 text-sm placeholder-gray-400 transition" />
          </div>

          <!-- Cardholder name -->
          <input type="text" placeholder="Card Holder Name"
            class="w-full border border-gray-200 rounded px-4 py-2.5 text-sm placeholder-gray-400 transition" />

          <!-- Save checkbox -->
          <label class="flex items-center gap-2 text-sm text-gray-500 cursor-pointer select-none">
            <input type="checkbox" class="w-4 h-4 rounded" />
            Save This Info For Future
          </label>
        </div>
      </section>

      <!-- Pay button -->
      <button
        class="w-full bg-crimson hover:bg-crimson-dark text-white font-semibold py-3 rounded text-sm tracking-widest uppercase transition">
        Pay Now
      </button>

      <!-- Footer note inside form -->
      <p class="text-center text-[11px] text-gray-400">Copyright © 2026 Stylo Fasion. All Rights Reserved.</p>
    </div>

    <!-- ── RIGHT: Order Summary ────────────────────────────── -->
    <aside class="lg:col-span-2 bg-gray-50 rounded-lg p-6 h-fit space-y-5">

      <!-- Product row -->
      <div class="flex items-center gap-4">
        <!-- Product image placeholder -->
        <div class="w-16 h-16 bg-gray-200 rounded flex items-center justify-center text-gray-400 text-2xl flex-shrink-0">
          <i class="fa-regular fa-image"></i>
        </div>
        <div>
          <p class="font-semibold text-gray-800 text-sm">Rosette Radiance</p>
        </div>
        <p class="ml-auto font-semibold text-gray-800 text-sm">₹697.00</p>
      </div>

      <!-- Coupon link -->
      <p class="text-crimson text-xs font-medium cursor-pointer hover:underline">Available Coupons....</p>

      <!-- Discount code -->
      <div class="flex gap-2">
        <input
          type="text"
          placeholder="Discount code"
          class="flex-1 border border-gray-200 rounded px-3 py-2 text-sm placeholder-gray-400 bg-white transition"
        />
        <button class="bg-crimson hover:bg-crimson-dark text-white text-sm px-4 py-2 rounded transition font-medium">
          Apply
        </button>
      </div>

      <!-- Price breakdown -->
      <div class="space-y-2 text-sm border-t border-gray-200 pt-4">
        <div class="flex justify-between text-gray-500">
          <span>Subtotal</span><span class="text-gray-700">₹697.00</span>
        </div>
        <div class="flex justify-between text-gray-500">
          <span>Shipping</span><span class="text-gray-700">₹40.00</span>
        </div>
        <div class="flex justify-between text-gray-500">
          <span>Discount</span><span class="text-gray-700">₹0.00</span>
        </div>
        <div class="flex justify-between font-bold text-gray-800 border-t border-gray-200 pt-3">
          <span>Total</span><span>₹737.00</span>
        </div>
      </div>
    </aside>
  </main>

  <!-- =========================================================
       FOOTER
  ========================================================= -->
  <footer class="bg-footer text-white mt-16">

    <!-- Curved top accent -->
    <div class="relative h-10 bg-white overflow-hidden">
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-48 h-10 bg-footer rounded-t-full"></div>
    </div>

    <div class="max-w-6xl mx-auto px-8 pt-12 pb-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand + App download -->
      <div class="space-y-4">
        <h3 class="font-display text-2xl italic font-semibold">Stylo Fasion</h3>
        <p class="text-sm text-gray-300">Download the Tanishq App Now</p>

        <!-- QR code placeholder -->
        <div class="w-28 h-28 bg-white rounded flex items-center justify-center">
          <i class="fa-solid fa-qrcode text-footer text-5xl"></i>
        </div>

        <!-- App store badges -->
        <div class="flex gap-3 flex-wrap">
          <a href="#" class="flex items-center gap-1.5 bg-black border border-gray-600 rounded px-3 py-1.5 text-xs hover:bg-gray-800 transition">
            <i class="fa-brands fa-google-play text-green-400 text-base"></i>
            <span class="leading-tight"><span class="block text-gray-400 text-[9px]">Download on the</span>Play Store</span>
          </a>
          <a href="#" class="flex items-center gap-1.5 bg-black border border-gray-600 rounded px-3 py-1.5 text-xs hover:bg-gray-800 transition">
            <i class="fa-brands fa-apple text-white text-base"></i>
            <span class="leading-tight"><span class="block text-gray-400 text-[9px]">Download on the</span>App Store</span>
          </a>
        </div>
      </div>

      <!-- Useful Links -->
      <div class="space-y-3">
        <h4 class="font-semibold text-sm uppercase tracking-widest text-gray-300">Useful Links</h4>
        <ul class="space-y-2 text-sm text-gray-400">
          <li><a href="#" class="hover:text-white transition">Delivery Information</a></li>
          <li><a href="#" class="hover:text-white transition">International Shipping</a></li>
          <li><a href="#" class="hover:text-white transition">Payment Options</a></li>
          <li><a href="#" class="hover:text-white transition">Track your Order</a></li>
          <li><a href="#" class="hover:text-white transition">Returns</a></li>
          <li><a href="#" class="hover:text-white transition">Find a Store</a></li>
        </ul>
      </div>

      <!-- Information -->
      <div class="space-y-3">
        <h4 class="font-semibold text-sm uppercase tracking-widest text-gray-300">Information</h4>
        <ul class="space-y-2 text-sm text-gray-400">
          <li><a href="#" class="hover:text-white transition">Blog</a></li>
          <li><a href="#" class="hover:text-white transition">Offers &amp; Contest Details</a></li>
          <li><a href="#" class="hover:text-white transition">Help &amp; FAQs</a></li>
          <li><a href="#" class="hover:text-white transition">About Tanishq</a></li>
        </ul>
      </div>

      <!-- Contact Us -->
      <div class="space-y-3">
        <h4 class="font-semibold text-sm uppercase tracking-widest text-gray-300">Contact Us</h4>
        <p class="text-sm text-gray-400">1800-266-0123</p>
        <h4 class="font-semibold text-sm uppercase tracking-widest text-gray-300 pt-1">Chat With Us</h4>
        <p class="text-sm text-gray-400">+91 8147349242</p>
        <div class="flex gap-4 pt-1 text-lg text-gray-400">
          <a href="#" class="hover:text-green-400 transition"><i class="fa-brands fa-whatsapp"></i></a>
          <a href="#" class="hover:text-white transition"><i class="fa-regular fa-comment-dots"></i></a>
          <a href="#" class="hover:text-white transition"><i class="fa-regular fa-message"></i></a>
        </div>
        <hr class="border-gray-700 mt-1" />
      </div>
    </div>

    <!-- Social + Payment logos row -->
    <div class="border-t border-gray-700 max-w-6xl mx-auto px-8 py-6 flex flex-col md:flex-row items-center justify-between gap-6">

      <!-- Social -->
      <div class="flex items-center gap-4 text-gray-400 text-xl">
        <span class="text-sm font-semibold text-white mr-2">Social</span>
        <a href="#" class="hover:text-pink-400 transition"><i class="fa-brands fa-instagram"></i></a>
        <a href="#" class="hover:text-white transition"><i class="fa-brands fa-x-twitter"></i></a>
        <a href="#" class="hover:text-blue-400 transition"><i class="fa-brands fa-facebook-f"></i></a>
        <a href="#" class="hover:text-red-500 transition"><i class="fa-brands fa-youtube"></i></a>
      </div>

      <!-- Payment icons -->
      <div class="flex items-center gap-3 text-2xl text-gray-400">
        <i class="fa-brands fa-cc-visa hover:text-blue-400 transition cursor-pointer"></i>
        <i class="fa-brands fa-cc-mastercard hover:text-red-400 transition cursor-pointer"></i>
        <i class="fa-brands fa-cc-amex hover:text-blue-300 transition cursor-pointer"></i>
        <i class="fa-brands fa-cc-discover hover:text-orange-400 transition cursor-pointer"></i>
        <i class="fa-brands fa-cc-diners-club hover:text-gray-200 transition cursor-pointer"></i>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="bg-black/30 py-4 text-center text-xs text-gray-500 flex flex-col sm:flex-row items-center justify-center gap-4 px-4">
      <span>© 2025 Titan Company Limited. All Rights Reserved.</span>
      <div class="flex gap-4">
        <a href="#" class="hover:text-white transition">Terms &amp; Conditions</a>
        <a href="#" class="hover:text-white transition">Privacy Policy</a>
        <a href="#" class="hover:text-white transition">Disclaimer</a>
      </div>
    </div>
  </footer>

</body>
</html>
